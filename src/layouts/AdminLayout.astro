---
import Sidebar from "@components/admin/Sidebar.astro";
import Topbar from "@components/admin/Topbar.astro";
import "~/styles/styles.css";
import "~/styles/admin.css";
import "~/styles/crm.css";

interface Props {
  title: string;
  active?: string | undefined;
  breadcrumb: string;
  screenLabel?: string | undefined;
}

const { title, active, breadcrumb, screenLabel } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-screen-label={screenLabel}>
    <div class="admin-shell">
      <Sidebar active={active} />
      <main class="admin-main">
        <Topbar breadcrumb={breadcrumb} />
        <div class="admin-page">
          <slot />
        </div>
      </main>
    </div>
    <script>
      import "~/scripts/admin.ts";
    </script>
  </body>
</html>
