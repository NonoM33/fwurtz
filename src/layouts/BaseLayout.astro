---
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import RdvModal from "@components/layout/RdvModal.astro";
import Concierge from "@components/concierge/Concierge.astro";

import "~/styles/styles.css";
import "~/styles/concierge.css";

interface Props {
  title: string;
  description: string;
  active?: "accueil" | "services" | "apropos" | "processus" | "ressources" | "contact";
  screenLabel?: string;
}

const {
  title,
  description,
  active = "accueil",
  screenLabel,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://maison-fwurtz.fr";
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#08111E" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-screen-label={screenLabel}>
    <Header active={active} />
    <slot />
    <Footer />
    <RdvModal />
    <Concierge />

    <script>
      import "~/scripts/interactions.ts";
      import "~/scripts/image-slot.ts";
      import "~/features/concierge/presentation/concierge.client.ts";
    </script>
  </body>
</html>
