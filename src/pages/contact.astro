---
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact — Maison Fwurtz"
  description="Une question ? Un projet ? Écrivez-nous, nous vous répondons sous 24h ouvrées."
  active="contact"
>
<section class="page-hero">
  <div class="page-hero__bg"><div class="hero__photo"><div class="hero-portrait"><div class="hero-portrait__silhouette"></div></div></div><div class="hero__overlay"></div></div>
  <div class="container"><div class="page-hero__grid">
    <div class="page-hero__content">
      <div class="reveal"><span class="eyebrow">Contact</span></div>
      <h1 class="reveal reveal-delay-1 serif">Parlons de <em class="italic">votre projet.</em></h1>
      <div class="reveal reveal-delay-2"><div class="divider"></div></div>
      <p class="lead reveal reveal-delay-2">Chaque projet mérite une attention unique. Échangeons sur vos besoins et construisons ensemble la meilleure solution.</p>
    </div>
    <div class="reveal reveal-delay-2">
      <div class="slot-frame slot-frame--tall" style="max-height: 460px; height: 100%;">
        <image-slot id="contact-hero" shape="rounded" radius="12" placeholder="Glissez portrait — accueil" style="width:100%; height:100%;"></image-slot>
        <div class="slot-frame__caption">Portrait — accueil</div>
      </div>
    </div>
  </div></div>
</section>

<section class="section" style="background: var(--navy-900);">
  <div class="container">
    <div class="two-col" style="align-items: start;">
      <div class="contact-info reveal">
        <h3>Nos coordonnées</h3>
        <ul>
          <li><div class="contact-info__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 16.9v3a2 2 0 01-2.2 2A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.6a2 2 0 01-.5 2.1L8 9.7a16 16 0 006.3 6.3l1.3-1.3a2 2 0 012.1-.5c.8.3 1.7.5 2.6.6a2 2 0 011.7 2z"/></svg></div><div><div class="contact-info__primary">06 21 22 23 24</div><div class="contact-info__sub">Du lundi au vendredi<br>9h00 – 18h00</div></div></li>
          <li><div class="contact-info__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></div><div><div class="contact-info__primary">contact@maison-fwurtz.fr</div><div class="contact-info__sub">Réponse sous 24h ouvrées</div></div></li>
          <li><div class="contact-info__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></div><div><div class="contact-info__primary">Paris, France</div><div class="contact-info__sub">Déplacements possibles<br>selon les projets</div></div></li>
        </ul>
      </div>

      <div class="form-card reveal reveal-delay-1">
        <h3>Envoyez-nous un message</h3>
        <form class="contact-form" data-fake-submit>
          <div class="form-field"><input type="text" placeholder="Nom complet" required></div>
          <div class="form-field"><input type="email" placeholder="Adresse e-mail" required></div>
          <div class="form-field"><input type="text" placeholder="Sujet"></div>
          <div class="form-field"><textarea placeholder="Votre message"></textarea></div>
          <button type="submit" class="btn btn--outline btn--lg">Envoyer le message</button>
        </form>
      </div>
    </div>

    <div class="cta-band reveal" style="margin-top: 48px;">
      <div style="display:flex; align-items:center; gap: 24px;">
        <div style="width: 52px; height: 52px; border: 1px solid var(--gold-line); border-radius: 999px; display:flex; align-items:center; justify-content:center; color: var(--gold); flex-shrink: 0;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="8" y1="3" x2="8" y2="7"/><line x1="16" y1="3" x2="16" y2="7"/><circle cx="12" cy="15" r="2"/></svg>
        </div>
        <div class="cta-band__title" style="font-size: 26px;">Prendre rendez-vous<br>pour un échange.</div>
      </div>
      <p class="cta-band__sub">Échangeons sur vos besoins et trouvons ensemble les solutions les plus adaptées à vos projets.</p>
      <a class="btn btn--outline" href="#" data-open-rdv>Prendre rendez-vous</a>
    </div>
  </div>
</section>

<section class="section" style="background: var(--navy-950);">
  <div class="container">
    <div class="values-grid" style="grid-template-columns: repeat(3, 1fr);">
      <div class="value-card reveal" style="background: transparent; border: none;">
        <svg class="value-card__icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="11" y="22" width="26" height="20" rx="2"/><path d="M16 22 V14 a8 8 0 0116 0 V22"/></svg>
        <h3 class="serif">Confidentialité</h3>
        <p>Vos informations sont traitées avec la plus grande discrétion.</p>
      </div>
      <div class="value-card reveal reveal-delay-1" style="background: transparent; border: none;">
        <svg class="value-card__icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="18"/><path d="M24 12 V24 L32 28"/></svg>
        <h3 class="serif">Réactivité</h3>
        <p>Nous nous engageons à vous répondre dans les meilleurs délais.</p>
      </div>
      <div class="value-card reveal reveal-delay-2" style="background: transparent; border: none;">
        <svg class="value-card__icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="16" r="7"/><path d="M10 42 C10 32 17 28 24 28 C31 28 38 32 38 42"/></svg>
        <h3 class="serif">Accompagnement</h3>
        <p>Un suivi personnalisé à chaque étape de votre projet.</p>
      </div>
    </div>
  </div>
</section>
</BaseLayout>
