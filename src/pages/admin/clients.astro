    <div class="kpi"><div class="kpi__head"><span class="kpi__label">CA cumulé · année</span></div><div class="kpi__value">87&nbsp;<em>200</em>&nbsp;€</div><div class="kpi__delta kpi__delta--up"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5V19"/><path d="M5 12L12 5L19 12"/></svg> +34 % YoY</div></div>
    <div class="kpi"><div class="kpi__head"><span class="kpi__label">Panier moyen</span></div><div class="kpi__value">7&nbsp;<em>266</em>&nbsp;€</div><div class="kpi__delta" style="color: var(--ink-3);">Sur 12 clients actifs</div></div>
