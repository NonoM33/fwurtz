---
export const prerender = false;
import AdminLayout from "~/layouts/AdminLayout.astro";

const body = `

  <div class="admin-page-head">
    <div>
      <h1 class="admin-page-head__title">Carnet <em>de clients</em></h1>
      <p class="admin-page-head__sub">38 contacts au total · 12 clients actifs · CA cumulé 2026 : <strong style="color: var(--gold);">87 200 €</strong></p>
    </div>
    <div class="admin-page-head__actions">
      <button class="btn-admin btn-admin--ghost"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 4 h18 v4 l-7 7 v6 l-4-2 v-4 l-7-7 z"/></svg> Filtrer</button>
      <button class="btn-admin btn-admin--ghost"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg> Importer</button>
      <button class="btn-admin btn-admin--primary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Ajouter un client</button>
    </div>
  </div>

  <!-- Segments -->
  <div class="kpi-grid" style="grid-template-columns: repeat(4, 1fr); margin-bottom: 24px;">
    <div class="kpi"><div class="kpi__head"><span class="kpi__label">Clients actifs</span></div><div class="kpi__value"><em>12</em></div><div class="kpi__delta kpi__delta--up"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5V19"/><path d="M5 12L12 5L19 12"/></svg> +2 ce mois</div></div>
