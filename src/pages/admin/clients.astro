      <input type="text" placeholder="Nom, e-mail, entreprise…" class="input-admin" style="padding-left: 36px;">
    </div>
    <div class="tabs">
      <button class="tabs__tab is-active">Tous (38)</button>
      <button class="tabs__tab">Clients (12)</button>
      <button class="tabs__tab">Récurrents (4)</button>
      <button class="tabs__tab">Prospects (9)</button>
      <button class="tabs__tab">Perdus (5)</button>
    </div>
    <div class="assignee-pills" style="margin-left: auto;">
      <button class="assignee-pill is-active"><span class="assignee-pill__avatar" style="background: var(--admin-surface-3);">⊕</span><span>Tous</span></button>
