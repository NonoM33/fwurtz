            <td><strong style="color: var(--ink);">12</strong></td>
            <td><strong style="color: var(--gold); font-family: var(--font-serif); font-style: italic;">38&nbsp;400&nbsp;€</strong></td>
            <td>5</td>
            <td>3</td>
            <td><strong style="color: #6BCB77;">2</strong></td>
            <td><strong style="color: var(--gold);">38 %</strong></td>
