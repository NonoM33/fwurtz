        <div class="card__sub">Comparaison ce mois · pipeline et conversion par personne</div>
      </div>
      <div class="tabs">
        <button class="tabs__tab is-active">Mai</button>
        <button class="tabs__tab">Q2</button>
        <button class="tabs__tab">Année</button>
      </div>
    </div>
    <div class="card__body">
      <table class="tbl" style="width: 100%;">
