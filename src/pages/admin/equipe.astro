---
export const prerender = false;
import AdminLayout from "~/layouts/AdminLayout.astro";
import { usersRepo } from "@features/users/infra/repository.ts";
import { ROLES, ROLE_LABELS, ROLE_DESCRIPTIONS, initialsOf } from "@features/users/domain/types.ts";

const users = usersRepo().list();
---

<AdminLayout
  title="Équipe — Maison Fwurtz Admin"
  active="equipe"
  breadcrumb="Équipe & rôles"
  screenLabel="Admin · Équipe"
>
  <div class="admin-page-head">
    <div>
      <h1 class="admin-page-head__title">Équipe <em>& rôles</em></h1>
      <p class="admin-page-head__sub">
        {users.length} collaborateur{users.length > 1 ? "s" : ""} · 5 rôles disponibles avec permissions différentes
      </p>
    </div>
    <div class="admin-page-head__actions">
      <button class="btn-admin btn-admin--primary" id="new-user-btn">+ Inviter un collaborateur</button>
    </div>
  </div>

  <div class="card" id="form-card" style="display: none; margin-bottom: 16px;">
    <div class="card__head">
      <div>
        <h3 class="card__title" id="form-title">Inviter <em>un collaborateur</em></h3>
        <div class="card__sub">Le collaborateur recevra un mot de passe initial à changer à la première connexion</div>
      </div>
      <div class="card__actions">
        <button class="btn-admin btn-admin--ghost" id="form-cancel">Annuler</button>
      </div>
    </div>
    <div class="card__body">
      <form id="user-form" class="form-grid" onsubmit="return false;">
        <input type="hidden" id="f-id" />
        <div class="form-row">
          <div><div class="form-label">Nom</div></div>
          <div><input class="input-admin" id="f-name" placeholder="Léa Martin" required /></div>
        </div>
        <div class="form-row">
          <div><div class="form-label">Email</div></div>
          <div><input class="input-admin" id="f-email" type="email" placeholder="lea@maison-fwurtz.fr" required /></div>
        </div>
        <div class="form-row">
          <div><div class="form-label">Rôle</div><div class="form-help">Définit les sections accessibles</div></div>
          <div>
            <select class="input-admin" id="f-role">
              {ROLES.map((r) => <option value={r}>{ROLE_LABELS[r]} — {ROLE_DESCRIPTIONS[r]}</option>)}
            </select>
          </div>
        </div>
        <div class="form-row" id="f-pwd-row">
          <div><div class="form-label">Mot de passe initial</div><div class="form-help">Optionnel — auto-généré si laissé vide</div></div>
          <div><input class="input-admin" id="f-password" type="text" placeholder="(auto-généré)" /></div>
        </div>
      </form>
    </div>
    <div class="card__foot">
      <span id="form-error" style="color: #E67878; font-size: 12.5px;"></span>
      <div style="display: flex; gap: 8px; margin-left: auto;">
        <button class="btn-admin btn-admin--primary" id="form-save">Enregistrer</button>
      </div>
    </div>
  </div>

  <div class="card" style="margin-bottom: 16px;">
    <div class="card__head">
      <div>
        <h3 class="card__title">Collaborateurs</h3>
        <div class="card__sub">{users.length} actif{users.length > 1 ? "s" : ""}</div>
      </div>
    </div>
    <div class="card__body card__body--flush">
      <table class="tbl">
        <thead>
          <tr>
            <th>Personne</th>
            <th>Email</th>
            <th>Rôle</th>
            <th>Ajouté le</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="users-tbody">
          {users.map((u) => (
            <tr data-uid={u.id}>
              <td>
                <div class="tbl__primary">
                  <div class="tbl__avatar">{initialsOf(u.name)}</div>
                  <div>
                    <div class="tbl__name">{u.name}</div>
                    <div class="tbl__meta">ID <code style="font-family: ui-monospace, monospace; font-size: 10px;">{u.id.slice(0, 8)}</code></div>
                  </div>
                </div>
              </td>
              <td><a href={`mailto:${u.email}`} style="color: var(--ink-2);">{u.email}</a></td>
              <td>
                <span class={`role-badge role-badge--${u.role}`}>{ROLE_LABELS[u.role]}</span>
              </td>
              <td style="font-size: 11.5px; color: var(--ink-4); font-family: ui-monospace, monospace;">{u.createdAt.slice(0, 10)}</td>
              <td>
                <div class="row-actions">
                  <button class="btn-admin btn-admin--ghost" data-edit={u.id} style="padding: 5px 10px; font-size: 11px;">Éditer</button>
                  <button class="btn-admin btn-admin--danger" data-delete={u.id} style="padding: 5px 10px; font-size: 11px;">×</button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card__head">
      <div>
        <h3 class="card__title">Rôles <em>& permissions</em></h3>
        <div class="card__sub">Les 5 rôles fixes du système — chacun donne accès à un sous-ensemble du back-office</div>
      </div>
    </div>
    <div class="card__body">
      <div style="display: grid; gap: 12px;">
        {ROLES.map((r) => (
          <div style="display: grid; grid-template-columns: 200px 1fr; gap: 16px; align-items: start; padding: 14px 0; border-bottom: 1px solid var(--admin-line-soft);">
            <div>
              <span class={`role-badge role-badge--${r}`}>{ROLE_LABELS[r]}</span>
            </div>
            <div style="font-size: 13.5px; color: var(--ink-2);">{ROLE_DESCRIPTIONS[r]}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ items: users }}>
    const formCard = document.getElementById("form-card");
    const errorEl = document.getElementById("form-error");
    const titleEl = document.getElementById("form-title");
    const els = {
      id: document.getElementById("f-id"),
      name: document.getElementById("f-name"),
      email: document.getElementById("f-email"),
      role: document.getElementById("f-role"),
      password: document.getElementById("f-password"),
    };
    const pwdRow = document.getElementById("f-pwd-row");

    function showForm(u) {
      errorEl.textContent = "";
      if (u) {
        titleEl.innerHTML = "Modifier <em>" + escapeHtml(u.name) + "</em>";
        els.id.value = u.id;
        els.name.value = u.name;
        els.email.value = u.email;
        els.role.value = u.role;
        pwdRow.style.display = "none";
      } else {
        titleEl.innerHTML = "Inviter <em>un collaborateur</em>";
        els.id.value = "";
        els.name.value = "";
        els.email.value = "";
        els.role.value = "viewer";
        els.password.value = "";
        pwdRow.style.display = "";
      }
      formCard.style.display = "";
      formCard.scrollIntoView({ behavior: "smooth", block: "start" });
      els.name.focus();
    }
    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));
    }

    document.getElementById("new-user-btn").addEventListener("click", () => showForm(null));
    document.getElementById("form-cancel").addEventListener("click", () => formCard.style.display = "none");
    document.getElementById("form-save").addEventListener("click", async () => {
      const id = els.id.value;
      const payload = {
        name: els.name.value.trim(),
        email: els.email.value.trim(),
        role: els.role.value,
      };
      if (!id && els.password.value.trim()) payload.password = els.password.value.trim();
      if (!payload.name || !payload.email.includes("@")) {
        errorEl.textContent = "Nom et email valides sont obligatoires.";
        return;
      }
      const r = await fetch(id ? "/api/admin/users/" + encodeURIComponent(id) : "/api/admin/users", {
        method: id ? "PATCH" : "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!r.ok) {
        const err = await r.json().catch(() => ({}));
        errorEl.textContent = err.error === "email_taken" ? "Cet email est déjà utilisé." : "Échec (" + r.status + ").";
        return;
      }
      window.location.reload();
    });

    document.querySelectorAll("[data-edit]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const u = items.find((x) => x.id === btn.getAttribute("data-edit"));
        if (u) showForm(u);
      });
    });
    document.querySelectorAll("[data-delete]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!confirm("Supprimer ce collaborateur ?")) return;
        const row = btn.closest("tr");
        const r = await fetch("/api/admin/users/" + encodeURIComponent(btn.getAttribute("data-delete")), {
          method: "DELETE",
          headers: { "content-type": "application/json" },
        });
        if (!r.ok) { alert("Échec."); return; }
        row?.remove();
      });
    });
  </script>
</AdminLayout>
