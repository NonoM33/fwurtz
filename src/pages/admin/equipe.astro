        <span style="display: inline-flex; align-items: center; gap: 6px;"><svg viewBox="0 0 24 24" fill="none" stroke="var(--admin-line)" stroke-width="2" width="13" height="13"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg> Refusé</span>
      </div>
      <button class="btn-admin btn-admin--primary" style="padding: 7px 14px; font-size: 12px;" data-save>Enregistrer les modifications</button>
    </div>
  </div>

  <!-- Sales performance leaderboard -->
