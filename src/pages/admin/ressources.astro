---
export const prerender = false;
import AdminLayout from "~/layouts/AdminLayout.astro";

const body = `

  <div class="admin-page-head">
    <div>
      <h1 class="admin-page-head__title">Ressources <em>& E-books</em></h1>
      <p class="admin-page-head__sub">4 e-books en vente · 247 téléchargements cumulés ce trimestre</p>
    </div>
    <div class="admin-page-head__actions">
      <button class="btn-admin btn-admin--ghost">Voir les ventes</button>
      <button class="btn-admin btn-admin--primary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Nouvel e-book</button>
    </div>
  </div>

  <div class="kpi-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 24px;">
    <div class="kpi">
      <div class="kpi__head"><span class="kpi__label">Ventes · ce mois</span></div>
      <div class="kpi__value"><em>89</em></div>
      <div class="kpi__delta kpi__delta--up"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5V19"/><path d="M5 12L12 5L19 12"/></svg> +23 % vs avril</div>
    </div>
    <div class="kpi">
      <div class="kpi__head"><span class="kpi__label">Chiffre d'affaires</span></div>
      <div class="kpi__value"><em>3&nbsp;156</em>&nbsp;€</div>
      <div class="kpi__delta kpi__delta--up"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5V19"/><path d="M5 12L12 5L19 12"/></svg> +18 %</div>
    </div>
    <div class="kpi">
      <div class="kpi__head"><span class="kpi__label">Conversion visiteur → acheteur</span></div>
      <div class="kpi__value"><em>2,8</em>&nbsp;%</div>
      <div class="kpi__delta kpi__delta--up"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5V19"/><path d="M5 12L12 5L19 12"/></svg> +0,4 pt</div>
    </div>
  </div>

  <div class="card">
    <div class="card__head">
      <div>
        <h3 class="card__title">Vos <em>e-books</em></h3>
        <div class="card__sub">Glisser pour réordonner sur la page Ressources</div>
      </div>
    </div>
    <div class="card__body" style="padding: 24px;">
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px;">

        <div style="background: var(--admin-surface-2); border: 1px solid var(--admin-line); border-radius: 12px; overflow: hidden;">
          <div style="aspect-ratio: 4/3; background: linear-gradient(135deg, #0a1320 0%, #14223a 100%); display: flex; align-items: center; justify-content: center; position: relative;">
            <div style="width: 90px; aspect-ratio: 2/3; background: linear-gradient(135deg, #0d1729, #050a14); border-radius: 2px 4px 4px 2px; box-shadow: -3px 4px 0 rgba(0,0,0,0.3); padding: 14px 12px; display: flex; flex-direction: column; justify-content: center; text-align: center;">
              <div style="font-size: 7px; letter-spacing: 0.15em; color: var(--gold); margin-bottom: 10px;">GUIDE</div>
              <div style="font-family: var(--font-serif); font-size: 9px; color: var(--ink); line-height: 1.2; letter-spacing: 0.05em; text-transform: uppercase; font-weight: 500;">ORGANISATION & PRODUCTIVITÉ</div>
            </div>
            <span class="badge badge--published" style="position: absolute; top: 12px; right: 12px;">Publié</span>
          </div>
          <div style="padding: 18px 20px 20px;">
            <div style="font-family: var(--font-serif); font-size: 16px; color: var(--ink); font-weight: 500; margin-bottom: 4px;">Organisation & Productivité</div>
            <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px;">
              <span style="color: var(--gold); font-family: var(--font-serif); font-size: 20px;">29 €</span>
              <span style="font-size: 11px; color: var(--ink-4); font-family: ui-monospace, monospace;">↓ 67 téléchargements</span>
            </div>
            <div style="display: flex; gap: 6px;">
              <button class="btn-admin btn-admin--ghost" style="padding: 6px 10px; font-size: 11px; flex: 1;">Modifier</button>
              <button class="row-action" style="border-color: var(--admin-line);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12 C5 6 9 4 12 4 C15 4 19 6 22 12 C19 18 15 20 12 20 C9 20 5 18 2 12 Z"/><circle cx="12" cy="12" r="3"/></svg></button>
            </div>
          </div>
        </div>

        <div style="background: var(--admin-surface-2); border: 1px solid var(--admin-line); border-radius: 12px; overflow: hidden;">
          <div style="aspect-ratio: 4/3; background: linear-gradient(135deg, #0a1320 0%, #14223a 100%); display: flex; align-items: center; justify-content: center; position: relative;">
            <div style="width: 90px; aspect-ratio: 2/3; background: linear-gradient(135deg, #0d1729, #050a14); border-radius: 2px 4px 4px 2px; box-shadow: -3px 4px 0 rgba(0,0,0,0.3); padding: 14px 12px; display: flex; flex-direction: column; justify-content: center; text-align: center;">
              <div style="font-size: 7px; letter-spacing: 0.15em; color: var(--gold); margin-bottom: 10px;">GUIDE</div>
              <div style="font-family: var(--font-serif); font-size: 9px; color: var(--ink); line-height: 1.2; letter-spacing: 0.05em; text-transform: uppercase; font-weight: 500;">REVENUS COMPLÉMENTAIRES</div>
            </div>
            <span class="badge badge--published" style="position: absolute; top: 12px; right: 12px;">Publié</span>
          </div>
          <div style="padding: 18px 20px 20px;">
            <div style="font-family: var(--font-serif); font-size: 16px; color: var(--ink); font-weight: 500; margin-bottom: 4px;">Revenus complémentaires</div>
            <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px;">
              <span style="color: var(--gold); font-family: var(--font-serif); font-size: 20px;">39 €</span>
              <span style="font-size: 11px; color: var(--ink-4); font-family: ui-monospace, monospace;">↓ 82 téléchargements</span>
            </div>
            <div style="display: flex; gap: 6px;">
              <button class="btn-admin btn-admin--ghost" style="padding: 6px 10px; font-size: 11px; flex: 1;">Modifier</button>
              <button class="row-action" style="border-color: var(--admin-line);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12 C5 6 9 4 12 4 C15 4 19 6 22 12 C19 18 15 20 12 20 C9 20 5 18 2 12 Z"/><circle cx="12" cy="12" r="3"/></svg></button>
            </div>
          </div>
        </div>

        <div style="background: var(--admin-surface-2); border: 1px solid var(--gold-line); border-radius: 12px; overflow: hidden;">
          <div style="aspect-ratio: 4/3; background: linear-gradient(135deg, #0a1320 0%, #14223a 100%); display: flex; align-items: center; justify-content: center; position: relative;">
            <div style="width: 90px; aspect-ratio: 2/3; background: linear-gradient(135deg, #0d1729, #050a14); border-radius: 2px 4px 4px 2px; box-shadow: -3px 4px 0 rgba(0,0,0,0.3); padding: 14px 12px; display: flex; flex-direction: column; justify-content: center; text-align: center;">
              <div style="font-size: 7px; letter-spacing: 0.15em; color: var(--gold); margin-bottom: 10px;">GUIDE</div>
              <div style="font-family: var(--font-serif); font-size: 9px; color: var(--ink); line-height: 1.2; letter-spacing: 0.05em; text-transform: uppercase; font-weight: 500;">LANCER SON ACTIVITÉ</div>
            </div>
            <span class="badge badge--new" style="position: absolute; top: 12px; right: 12px;">★ Bestseller</span>
          </div>
          <div style="padding: 18px 20px 20px;">
            <div style="font-family: var(--font-serif); font-size: 16px; color: var(--ink); font-weight: 500; margin-bottom: 4px;">Lancer son activité</div>
            <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px;">
              <span style="color: var(--gold); font-family: var(--font-serif); font-size: 20px;">49 €</span>
              <span style="font-size: 11px; color: var(--gold); font-family: ui-monospace, monospace;">↓ 71 ce mois</span>
            </div>
            <div style="display: flex; gap: 6px;">
              <button class="btn-admin btn-admin--ghost" style="padding: 6px 10px; font-size: 11px; flex: 1;">Modifier</button>
              <button class="row-action" style="border-color: var(--admin-line);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12 C5 6 9 4 12 4 C15 4 19 6 22 12 C19 18 15 20 12 20 C9 20 5 18 2 12 Z"/><circle cx="12" cy="12" r="3"/></svg></button>
            </div>
          </div>
        </div>

        <div style="background: var(--admin-surface-2); border: 1px solid var(--admin-line); border-radius: 12px; overflow: hidden;">
          <div style="aspect-ratio: 4/3; background: linear-gradient(135deg, #0a1320 0%, #14223a 100%); display: flex; align-items: center; justify-content: center; position: relative;">
            <div style="width: 90px; aspect-ratio: 2/3; background: linear-gradient(135deg, #0d1729, #050a14); border-radius: 2px 4px 4px 2px; box-shadow: -3px 4px 0 rgba(0,0,0,0.3); padding: 14px 12px; display: flex; flex-direction: column; justify-content: center; text-align: center;">
              <div style="font-size: 7px; letter-spacing: 0.15em; color: var(--gold); margin-bottom: 10px;">GUIDE</div>
              <div style="font-family: var(--font-serif); font-size: 9px; color: var(--ink); line-height: 1.2; letter-spacing: 0.05em; text-transform: uppercase; font-weight: 500;">PRÉSENCE EN LIGNE</div>
            </div>
            <span class="badge badge--published" style="position: absolute; top: 12px; right: 12px;">Publié</span>
          </div>
          <div style="padding: 18px 20px 20px;">
            <div style="font-family: var(--font-serif); font-size: 16px; color: var(--ink); font-weight: 500; margin-bottom: 4px;">Présence en ligne</div>
            <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px;">
              <span style="color: var(--gold); font-family: var(--font-serif); font-size: 20px;">29 €</span>
              <span style="font-size: 11px; color: var(--ink-4); font-family: ui-monospace, monospace;">↓ 27 téléchargements</span>
            </div>
            <div style="display: flex; gap: 6px;">
              <button class="btn-admin btn-admin--ghost" style="padding: 6px 10px; font-size: 11px; flex: 1;">Modifier</button>
              <button class="row-action" style="border-color: var(--admin-line);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12 C5 6 9 4 12 4 C15 4 19 6 22 12 C19 18 15 20 12 20 C9 20 5 18 2 12 Z"/><circle cx="12" cy="12" r="3"/></svg></button>
            </div>
          </div>
        </div>

        <a href="#" style="background: transparent; border: 1.5px dashed var(--admin-line); border-radius: 12px; min-height: 280px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; color: var(--ink-3); text-decoration: none; transition: all 200ms;" onmouseover="this.style.borderColor='var(--gold)'; this.style.color='var(--gold)';" onmouseout="this.style.borderColor='var(--admin-line)'; this.style.color='var(--ink-3)';">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span style="font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase;">Nouvel e-book</span>
        </a>

      </div>
    </div>
  </div>`;
---

<AdminLayout
  title="Ressources — Maison Fwurtz Admin" active="ressources"
  breadcrumb="Ressources"
  screenLabel="Admin · Ressources"
>
  <Fragment set:html={body} />
</AdminLayout>
