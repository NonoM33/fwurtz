---
export const prerender = false;
import AdminLayout from "~/layouts/AdminLayout.astro";

const body = `

  <div class="admin-page-head">
    <div>
      <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 6px;">
        <a href="/admin/crm" style="color: var(--ink-3); font-size: 13px; text-decoration: none;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px;"><path d="M15 18l-6-6 6-6"/></svg> Pipeline</a>
        <span style="color: var(--ink-4); font-size: 12px;">·</span>
        <span class="badge badge--ongoing">Prospect qualifié</span>
        <span class="kcard__tag kcard__tag--ai">⌁ Score IA · 87/100</span>
      </div>
      <h1 class="admin-page-head__title">Camille <em>Larue</em></h1>
      <p class="admin-page-head__sub">Atelier Bardin · Céramiste · Lyon &middot; <a href="mailto:camille@atelier-bardin.fr" style="color: var(--gold);">camille@atelier-bardin.fr</a></p>
    </div>
    <div class="admin-page-head__actions">
      <button class="btn-admin btn-admin--ghost"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M22 16.9v3a2 2 0 01-2.2 2A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.6a2 2 0 01-.5 2.1L8 9.7a16 16 0 006.3 6.3l1.3-1.3a2 2 0 012.1-.5c.8.3 1.7.5 2.6.6a2 2 0 011.7 2z"/></svg> Appeler</button>
      <button class="btn-admin btn-admin--ghost"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg> Écrire</button>
      <button class="btn-admin btn-admin--primary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg> Planifier un RDV</button>
    </div>
  </div>

  <!-- Pipeline stages -->
  <div class="stages">
    <div class="stages__step is-done"><span class="stages__dot"></span><span>Prospect</span></div>
    <div class="stages__step is-current"><span class="stages__dot"></span><span>Qualifié</span></div>
    <div class="stages__step"><span class="stages__dot">3</span><span>RDV</span></div>
    <div class="stages__step"><span class="stages__dot">4</span><span>Devis</span></div>
    <div class="stages__step"><span class="stages__dot">5</span><span>Client</span></div>
  </div>

  <div class="client-detail">

    <!-- LEFT: Client card sidebar -->
    <aside class="client-card">
      <div class="client-card__cover"></div>
      <div class="client-card__inner">
        <div class="client-card__avatar">CL</div>
        <h2 class="client-card__name">Camille Larue</h2>
        <p class="client-card__org">Fondatrice · Atelier Bardin</p>

        <div class="client-card__stage">
          <button class="btn-admin btn-admin--ghost" style="width: 100%; justify-content: space-between;">
            <span>Faire avancer au RDV</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
          </button>
        </div>

        <!-- Score ring -->
        <div class="score-widget" style="margin: 0;">
          <div class="score-ring">
            <svg viewBox="0 0 60 60">
              <circle class="score-ring__bg" cx="30" cy="30" r="26"/>
              <circle class="score-ring__fg" cx="30" cy="30" r="26" stroke-dasharray="163.36" stroke-dashoffset="21.2"/>
            </svg>
            <div class="score-ring__value">87</div>
          </div>
          <div class="score-widget__body">
            <div class="score-widget__title">Score de qualification</div>
            <div class="score-widget__sub">Budget aligné · décideuse · timing court</div>
          </div>
        </div>

        <div class="client-card__meta">
          <div class="client-card__meta-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            <div>
              <div class="client-card__meta-label">E-mail</div>
              <a href="mailto:camille@atelier-bardin.fr">camille@atelier-bardin.fr</a>
            </div>
          </div>
          <div class="client-card__meta-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M22 16.9v3a2 2 0 01-2.2 2A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.6a2 2 0 01-.5 2.1L8 9.7a16 16 0 006.3 6.3l1.3-1.3a2 2 0 012.1-.5c.8.3 1.7.5 2.6.6a2 2 0 011.7 2z"/></svg>
            <div>
              <div class="client-card__meta-label">Téléphone</div>
              <span>06 ** ** ** **</span>
            </div>
          </div>
          <div class="client-card__meta-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <div>
              <div class="client-card__meta-label">Localisation</div>
              <span>Lyon, France</span>
            </div>
          </div>
          <div class="client-card__meta-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><line x1="3" y1="12" x2="21" y2="12"/><path d="M12 3 A14 14 0 0112 21 A14 14 0 0112 3"/></svg>
            <div>
              <div class="client-card__meta-label">Site web</div>
              <a href="#">atelier-bardin.fr</a>
            </div>
          </div>
          <div class="client-card__meta-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 4 h18 v4 l-7 7 v6 l-4-2 v-4 l-7-7 z"/></svg>
            <div>
              <div class="client-card__meta-label">Source</div>
              <span>Conciergerie · Marie</span>
            </div>
          </div>
          <div class="client-card__meta-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <div>
              <div class="client-card__meta-label">Premier contact</div>
              <span>15 mai 2026 · 19h12</span>
            </div>
          </div>
        </div>

        <!-- Assignee -->
        <div style="padding: 14px 0; border-top: 1px solid var(--admin-line);">
          <div class="client-card__meta-label" style="margin-bottom: 10px;">Commercial attribué</div>
          <div style="display: flex; align-items: center; gap: 10px;">
            <div class="tbl__avatar" style="width: 32px; height: 32px;">SF</div>
            <div style="flex: 1;">
              <div style="font-family: var(--font-serif); font-size: 14px; color: var(--ink);">Sophie Fwurtz</div>
              <div style="font-size: 11px; color: var(--ink-4);">Fondatrice</div>
            </div>
            <button class="row-action" title="Réattribuer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M1 4 v6 h6 M23 20 v-6 h-6"/><path d="M3.5 9 a9 9 0 0114.9-3 L23 10 M1 14 l4.6 4 a9 9 0 0014.9-3"/></svg></button>
          </div>
        </div>

        <div class="client-card__actions">
          <button class="btn-admin btn-admin--ghost"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M11 4 H4 a2 2 0 00-2 2 v14 a2 2 0 002 2 h14 a2 2 0 002-2 v-7"/><path d="M18 2 L22 6 L13 15 L8 16 L9 11 Z"/></svg> Modifier la fiche</button>
          <button class="btn-admin btn-admin--ghost"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 6 L10 6 L11 8 L21 8 L21 19 L3 19 Z"/></svg> Voir les fichiers</button>
        </div>
      </div>
    </aside>

    <!-- RIGHT: details -->
    <section>

      <!-- AI insight card -->
      <div class="ai-card">
        <div class="ai-card__head">
          <span class="ai-card__badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15 9 22 12 15 15 12 22 9 15 2 12 9 9"/></svg>
            Suggestion de Marie
          </span>
          <span style="font-size: 11px; color: var(--ink-4); margin-left: auto;">il y a 8 minutes</span>
        </div>
        <div class="ai-card__body">
          <strong>Prête à signer rapidement.</strong> Camille a un budget cohérent (5-7&nbsp;K€), un timing court (avant l'été) et est manifestement la décideuse. Le ton de ses messages est posé et professionnel — elle apprécie l'écoute. <br><br>
          <strong>Recommandation</strong> : confirmer le RDV de vendredi 14h en lui proposant en bonus un mini moodboard préparé sur Pinterest avant l'appel. Cela renforcera l'effet « cabinet attentif » sans engagement.
        </div>
        <div class="ai-card__actions">
          <button class="btn-admin btn-admin--primary" style="background: #C4B5FD; border-color: #C4B5FD; color: var(--admin-bg);">Préparer la réponse</button>
          <button class="btn-admin btn-admin--ghost">Voir tous les signaux</button>
        </div>
      </div>

      <!-- Tabs -->
      <div class="detail-tabs">
        <button class="detail-tab is-active">Activité <span class="detail-tab__count">12</span></button>
        <button class="detail-tab">Conversations <span class="detail-tab__count">2</span></button>
        <button class="detail-tab">Rendez-vous <span class="detail-tab__count">1</span></button>
        <button class="detail-tab">Devis & factures</button>
        <button class="detail-tab">Notes</button>
        <button class="detail-tab">Fichiers</button>
      </div>

      <!-- Two columns for content -->
      <div class="cols-2" style="grid-template-columns: 2fr 1fr;">

        <!-- Timeline -->
        <div class="card">
          <div class="card__head">
            <div>
              <h3 class="card__title">Activité <em>récente</em></h3>
              <div class="card__sub">Chronologie complète des interactions</div>
            </div>
            <button class="btn-admin btn-admin--ghost" style="padding: 7px 12px; font-size: 12px;">+ Ajouter une note</button>
          </div>
          <div class="card__body">
            <div class="timeline">

              <div class="timeline-item">
                <div class="timeline-item__head">
                  <span class="timeline-item__title">RDV planifié par <em>Sophie</em></span>
                  <span class="timeline-item__time">il y a 4 min</span>
                </div>
                <div class="timeline-item__type">Rendez-vous</div>
                <div class="timeline-item__body" style="margin-top: 6px;">
                  <strong style="font-family: var(--font-sans); font-style: normal; color: var(--gold); font-size: 12px;">VEN. 17 MAI · 14H00 — Visioconférence (60 min)</strong><br>
                  Premier échange · cadrage du projet de refonte de site éditorial pour l'atelier de céramique.
                </div>
              </div>

              <div class="timeline-item">
                <div class="timeline-item__head">
                  <span class="timeline-item__title">Score IA mis à jour : <em>87/100</em></span>
                  <span class="timeline-item__time">il y a 8 min</span>
                </div>
                <div class="timeline-item__type">Qualification IA</div>
                <div class="timeline-item__body" style="margin-top: 6px;">
                  Marie a analysé les 5 derniers messages. <em>Budget : aligné · Décideur : oui · Urgence : élevée · Fit culturel : excellent</em>.
                </div>
              </div>

              <div class="timeline-item">
                <div class="timeline-item__head">
                  <span class="timeline-item__title">Coordonnées transmises</span>
                  <span class="timeline-item__time">il y a 12 min</span>
                </div>
                <div class="timeline-item__type">Capture lead</div>
                <div class="timeline-item__body" style="margin-top: 6px;">
                  Camille a partagé ses coordonnées via la conciergerie : e-mail, téléphone, créneaux préférés (vendredi PM · lundi AM).
                </div>
              </div>

              <div class="timeline-item">
                <div class="timeline-item__head">
                  <span class="timeline-item__title">Conversation avec <em>Marie</em></span>
                  <span class="timeline-item__time">il y a 14 min</span>
                </div>
                <div class="timeline-item__type">Conciergerie</div>
                <div class="timeline-item__body" style="margin-top: 6px;">
                  6 échanges. Sujet : refonte site éditorial avec direction artistique minérale, budget 5-7&nbsp;K€. <a href="/admin/messages" style="color: var(--gold);">Lire la conversation →</a>
                </div>
              </div>

              <div class="timeline-item">
                <div class="timeline-item__head">
                  <span class="timeline-item__title">Visite de <em>/services/creation-sites-web</em></span>
                  <span class="timeline-item__time">il y a 21 min</span>
                </div>
                <div class="timeline-item__type">Navigation</div>
                <div class="timeline-item__body" style="margin-top: 6px;">
                  3 min 48 s sur la page · a lu l'étude de cas Galerie Saint-Honoré · a cliqué sur « Réserver un échange ».
                </div>
              </div>

              <div class="timeline-item">
                <div class="timeline-item__head">
                  <span class="timeline-item__title">Première visite du site</span>
                  <span class="timeline-item__time">il y a 28 min</span>
                </div>
                <div class="timeline-item__type">Acquisition</div>
                <div class="timeline-item__body" style="margin-top: 6px;">
                  Source : recherche Google · « agence design site céramique Lyon ». A consulté Accueil → Services → Création de sites web.
                </div>
              </div>

            </div>
          </div>
          <div class="card__foot">
            <span style="font-size: 12px; color: var(--ink-3);">Affichage des 6 dernières activités</span>
            <button class="btn-admin btn-admin--ghost" style="padding: 6px 12px; font-size: 12px;">Voir tout l'historique</button>
          </div>
        </div>

        <!-- Right column: AI signals + notes -->
        <div style="display: grid; gap: 16px;">

          <!-- AI signals -->
          <div class="card">
            <div class="card__head">
              <div>
                <h3 class="card__title">Signaux <em>détectés</em></h3>
                <div class="card__sub">Lecture des intentions par Marie</div>
              </div>
            </div>
            <div class="card__body" style="padding: 8px 24px 24px;">
              <div style="display: grid; gap: 14px; margin-top: 8px;">
                <div style="display: grid; grid-template-columns: 1fr 80px; align-items: center; gap: 12px;">
                  <span style="font-size: 12.5px; color: var(--ink-2);">Budget aligné</span>
                  <div style="height: 4px; background: var(--admin-surface-3); border-radius: 999px; overflow: hidden;"><div style="width: 92%; height: 100%; background: var(--gold);"></div></div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 80px; align-items: center; gap: 12px;">
                  <span style="font-size: 12.5px; color: var(--ink-2);">Décideur</span>
                  <div style="height: 4px; background: var(--admin-surface-3); border-radius: 999px; overflow: hidden;"><div style="width: 100%; height: 100%; background: var(--gold);"></div></div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 80px; align-items: center; gap: 12px;">
                  <span style="font-size: 12.5px; color: var(--ink-2);">Timing court</span>
                  <div style="height: 4px; background: var(--admin-surface-3); border-radius: 999px; overflow: hidden;"><div style="width: 78%; height: 100%; background: var(--gold);"></div></div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 80px; align-items: center; gap: 12px;">
                  <span style="font-size: 12.5px; color: var(--ink-2);">Fit culturel</span>
                  <div style="height: 4px; background: var(--admin-surface-3); border-radius: 999px; overflow: hidden;"><div style="width: 95%; height: 100%; background: var(--gold);"></div></div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 80px; align-items: center; gap: 12px;">
                  <span style="font-size: 12.5px; color: var(--ink-2);">Engagement</span>
                  <div style="height: 4px; background: var(--admin-surface-3); border-radius: 999px; overflow: hidden;"><div style="width: 68%; height: 100%; background: var(--gold);"></div></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Notes -->
          <div class="card">
            <div class="card__head">
              <div>
                <h3 class="card__title">Notes <em>internes</em></h3>
                <div class="card__sub">Visible par l'équipe uniquement</div>
              </div>
            </div>
            <div class="card__body">
              <div style="background: var(--admin-surface-2); border-left: 2px solid var(--gold); padding: 14px 16px; border-radius: 4px 8px 8px 4px; margin-bottom: 12px;">
                <div style="font-family: var(--font-serif); font-style: italic; font-size: 13px; color: var(--ink); line-height: 1.55;">« Très belle énergie. Donne l'impression d'avoir mûri son projet depuis un moment. Préparer un moodboard léger avant le RDV. »</div>
                <div style="font-size: 11px; color: var(--ink-4); margin-top: 8px;">Sophie · il y a 6 min</div>
              </div>
              <textarea class="input-admin" rows="3" placeholder="Ajouter une note…"></textarea>
              <button class="btn-admin btn-admin--primary" style="margin-top: 10px; width: 100%; justify-content: center;" data-save>Enregistrer la note</button>
            </div>
          </div>

          <!-- Related deals -->
          <div class="card">
            <div class="card__head">
              <div>
                <h3 class="card__title">Tags & <em>segments</em></h3>
              </div>
            </div>
            <div class="card__body">
              <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px;">
                <span class="kcard__tag kcard__tag--gold">Sites web</span>
                <span class="kcard__tag">Artisan</span>
                <span class="kcard__tag">Lyon</span>
                <span class="kcard__tag">Direct (Google)</span>
                <span class="kcard__tag kcard__tag--ai">Score élevé</span>
              </div>
              <button class="btn-admin btn-admin--ghost" style="width: 100%; justify-content: center; padding: 7px 12px; font-size: 12px;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Ajouter un tag</button>
            </div>
          </div>

        </div>
      </div>

    </section>

  </div>`;
---

<AdminLayout
  title="Fiche client — Maison Fwurtz Admin" active="clients"
  breadcrumb="Clients / Fiche client"
  screenLabel="Admin · Fiche client"
>
  <Fragment set:html={body} />
</AdminLayout>
