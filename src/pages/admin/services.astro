---
export const prerender = false;
import AdminLayout from "~/layouts/AdminLayout.astro";
import { servicesRepo } from "@features/services/infra/repository.ts";

const services = servicesRepo().list();
const counts = {
  total: services.length,
  published: services.filter((s) => s.published).length,
  drafts: services.filter((s) => !s.published).length,
};
---

<AdminLayout
  title="Services — Maison Fwurtz Admin"
  active="services"
  breadcrumb="Services"
  screenLabel="Admin · Services"
>
  <div class="admin-page-head">
    <div>
      <h1 class="admin-page-head__title">Services <em>du site</em></h1>
      <p class="admin-page-head__sub">
        {counts.total} services · <strong style="color: #6BCB77;">{counts.published} publié{counts.published > 1 ? "s" : ""}</strong>
        · {counts.drafts} brouillon{counts.drafts > 1 ? "s" : ""}
      </p>
    </div>
    <div class="admin-page-head__actions">
      <button class="btn-admin btn-admin--primary" id="new-svc-btn">+ Nouveau service</button>
    </div>
  </div>

  <div class="card" id="form-card" style="display: none; margin-bottom: 16px;">
    <div class="card__head">
      <div>
        <h3 class="card__title" id="form-title">Nouveau <em>service</em></h3>
        <div class="card__sub">L'URL publique sera <code>/services/[slug]</code></div>
      </div>
      <div class="card__actions">
        <button class="btn-admin btn-admin--ghost" id="form-cancel">Annuler</button>
      </div>
    </div>
    <div class="card__body">
      <form id="svc-form" class="form-grid" onsubmit="return false;">
        <input type="hidden" id="f-id" />
        <div class="form-row">
          <div>
            <div class="form-label">Titre</div>
            <div class="form-help">Affiché dans la grille et en titre H3</div>
          </div>
          <div>
            <input class="input-admin" id="f-title" placeholder="Création de sites web" required />
          </div>
        </div>
        <div class="form-row">
          <div>
            <div class="form-label">Slug</div>
            <div class="form-help">Auto-généré si laissé vide</div>
          </div>
          <div>
            <input class="input-admin" id="f-slug" placeholder="creation-sites-web" />
          </div>
        </div>
        <div class="form-row">
          <div>
            <div class="form-label">Résumé</div>
            <div class="form-help">Phrase descriptive (1-2 lignes)</div>
          </div>
          <div>
            <textarea class="input-admin" id="f-summary" rows="2" required></textarea>
          </div>
        </div>
        <div class="form-row">
          <div>
            <div class="form-label">Icône SVG</div>
            <div class="form-help">Markup interne (sans &lt;svg&gt;), viewBox 0 0 48 48</div>
          </div>
          <div>
            <textarea class="input-admin" id="f-icon" rows="3" style="font-family: ui-monospace, monospace; font-size: 12px;" placeholder='<rect x="6" y="9" width="36" height="24" rx="2"/>'></textarea>
          </div>
        </div>
        <div class="form-row">
          <div>
            <div class="form-label">Image hero</div>
            <div class="form-help">ID d'emplacement (médiathèque)</div>
          </div>
          <div>
            <input class="input-admin" id="f-hero" placeholder="sites-web-photo" />
          </div>
        </div>
        <div class="form-row">
          <div>
            <div class="form-label">Position</div>
            <div class="form-help">Ordre dans la grille (croissant)</div>
          </div>
          <div>
            <input class="input-admin" id="f-position" type="number" value="999" style="max-width: 100px;" />
          </div>
        </div>
        <div class="form-row">
          <div>
            <div class="form-label">Statut</div>
            <div class="form-help">Brouillons cachés du site public</div>
          </div>
          <div>
            <label style="display: inline-flex; align-items: center; gap: 10px; cursor: pointer;">
              <span class="switch">
                <input type="checkbox" id="f-published" checked />
                <span class="switch__slider"></span>
              </span>
              <span>Publié</span>
            </label>
          </div>
        </div>
      </form>
    </div>
    <div class="card__foot">
      <span id="form-error" style="color: #E67878; font-size: 12.5px;"></span>
      <div style="display: flex; gap: 8px; margin-left: auto;">
        <button class="btn-admin btn-admin--primary" id="form-save">Enregistrer</button>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card__body card__body--flush">
      <table class="tbl">
        <thead>
          <tr>
            <th>Service</th>
            <th>Slug</th>
            <th>Statut</th>
            <th>Position</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {services.map((s) => (
            <tr>
              <td>
                <div class="tbl__primary">
                  <div class="tbl__avatar" style="background: var(--admin-surface-3);">
                    {s.icon ? (
                      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" style="width: 18px; height: 18px; color: var(--gold);" set:html={s.icon} />
                    ) : (
                      <span>?</span>
                    )}
                  </div>
                  <div>
                    <div class="tbl__name">{s.title}</div>
                    <div class="tbl__meta tbl__excerpt" style="max-width: 36ch;">{s.summary}</div>
                  </div>
                </div>
              </td>
              <td><code style="font-family: ui-monospace, monospace; font-size: 12px; color: var(--ink-3);">/services/{s.slug}</code></td>
              <td>
                {s.published ? (
                  <span class="badge badge--done">Publié</span>
                ) : (
                  <span class="badge badge--draft">Brouillon</span>
                )}
              </td>
              <td style="font-family: ui-monospace, monospace; color: var(--ink-3);">{s.position}</td>
              <td>
                <div class="row-actions">
                  <button class="btn-admin btn-admin--ghost" data-edit={s.id} style="padding: 5px 10px; font-size: 11px;">Éditer</button>
                  <button class="btn-admin btn-admin--ghost" data-toggle-pub={s.id} style="padding: 5px 10px; font-size: 11px;">
                    {s.published ? "Dépublier" : "Publier"}
                  </button>
                  <button class="btn-admin btn-admin--danger" data-delete={s.id} style="padding: 5px 10px; font-size: 11px;">×</button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline define:vars={{ items: services }}>
    const formCard = document.getElementById("form-card");
    const errorEl = document.getElementById("form-error");
    const titleEl = document.getElementById("form-title");
    const fId = document.getElementById("f-id");
    const fTitle = document.getElementById("f-title");
    const fSlug = document.getElementById("f-slug");
    const fSummary = document.getElementById("f-summary");
    const fIcon = document.getElementById("f-icon");
    const fHero = document.getElementById("f-hero");
    const fPos = document.getElementById("f-position");
    const fPub = document.getElementById("f-published");

    function showForm(s) {
      errorEl.textContent = "";
      if (s) {
        titleEl.innerHTML = "Modifier <em>" + escapeHtml(s.title) + "</em>";
        fId.value = s.id;
        fTitle.value = s.title;
        fSlug.value = s.slug;
        fSummary.value = s.summary;
        fIcon.value = s.icon || "";
        fHero.value = s.heroImageSlot || "";
        fPos.value = String(s.position);
        fPub.checked = s.published;
      } else {
        titleEl.innerHTML = "Nouveau <em>service</em>";
        fId.value = "";
        fTitle.value = "";
        fSlug.value = "";
        fSummary.value = "";
        fIcon.value = "";
        fHero.value = "";
        fPos.value = "999";
        fPub.checked = true;
      }
      formCard.style.display = "";
      formCard.scrollIntoView({ behavior: "smooth", block: "start" });
      fTitle.focus();
    }
    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));
    }

    document.getElementById("new-svc-btn").addEventListener("click", () => showForm(null));
    document.getElementById("form-cancel").addEventListener("click", () => formCard.style.display = "none");
    document.getElementById("form-save").addEventListener("click", async () => {
      const payload = {
        title: fTitle.value.trim(),
        slug: fSlug.value.trim(),
        summary: fSummary.value.trim(),
        icon: fIcon.value.trim() || null,
        heroImageSlot: fHero.value.trim() || null,
        position: Number(fPos.value),
        published: fPub.checked,
      };
      if (!payload.title || !payload.summary) {
        errorEl.textContent = "Titre et résumé sont obligatoires.";
        return;
      }
      const id = fId.value;
      const r = await fetch(id ? "/api/admin/services/" + encodeURIComponent(id) : "/api/admin/services", {
        method: id ? "PATCH" : "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!r.ok) {
        const err = await r.json().catch(() => ({}));
        errorEl.textContent = err.error === "slug_taken" ? "Ce slug est déjà utilisé." : "Échec (" + r.status + ").";
        return;
      }
      window.location.reload();
    });

    document.querySelectorAll("[data-edit]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-edit");
        const s = items.find((x) => x.id === id);
        if (s) showForm(s);
      });
    });
    document.querySelectorAll("[data-delete]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!confirm("Supprimer définitivement ce service ?")) return;
        const row = btn.closest("tr");
        const r = await fetch("/api/admin/services/" + encodeURIComponent(btn.getAttribute("data-delete")), { method: "DELETE", headers: { "content-type": "application/json" } });
        if (!r.ok) { alert("Échec."); return; }
        row?.remove();
      });
    });
    document.querySelectorAll("[data-toggle-pub]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-toggle-pub");
        const s = items.find((x) => x.id === id);
        if (!s) return;
        const newPublished = !s.published;
        const r = await fetch("/api/admin/services/" + encodeURIComponent(id), {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ published: newPublished }),
        });
        if (!r.ok) { alert("Échec."); return; }
        s.published = newPublished;
        const row = btn.closest("tr");
        const statusCell = row?.querySelectorAll("td")[2];
        if (statusCell) {
          statusCell.innerHTML = newPublished
            ? '<span class="badge badge--done">Publié</span>'
            : '<span class="badge badge--draft">Brouillon</span>';
        }
        btn.textContent = newPublished ? "Dépublier" : "Publier";
      });
    });
  </script>
</AdminLayout>
