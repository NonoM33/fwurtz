---
export const prerender = false;
import AdminLayout from "~/layouts/AdminLayout.astro";
import { conversationsRepo } from "@features/conversations/infra/repository.ts";
import { STATUS_LABELS } from "@features/conversations/domain/types.ts";

const conversations = conversationsRepo().list();
const totals = conversationsRepo().totals();
const activeId = Astro.url.searchParams.get("c") ?? conversations[0]?.conversation.id ?? null;
const active = activeId ? conversationsRepo().get(activeId) : null;
const messages = activeId ? conversationsRepo().messages(activeId, { limit: 200 }) : [];
if (activeId) conversationsRepo().markAllRead(activeId);

function formatTime(iso: string): string {
  const d = new Date(iso);
  const today = new Date();
  if (d.toDateString() === today.toDateString()) {
    return d.toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" }).replace(":", "h");
  }
  return d.toLocaleDateString("fr-FR", { day: "2-digit", month: "short" });
}
---

<AdminLayout
  title="Messages — Maison Fwurtz Admin"
  active="messages"
  breadcrumb="Messages"
  screenLabel="Admin · Messages"
>
  <div class="admin-page-head">
    <div>
      <h1 class="admin-page-head__title">Messages <em>conciergerie</em></h1>
      <p class="admin-page-head__sub">
        {totals.open} en cours avec Marie · <strong style="color: #C4B5FD;">{totals.takenOver} pris en main</strong>
        {totals.unread > 0 && <> · <strong style="color: var(--gold);">{totals.unread} non lu{totals.unread > 1 ? "s" : ""}</strong></>}
      </p>
    </div>
  </div>

  <div class="convo">
    <div class="convo__list">
      <div class="convo__filter">
        <div class="tabs">
          <button class="tabs__tab is-active">Tous ({conversations.length})</button>
        </div>
      </div>
      <div class="convo__items">
        {conversations.length === 0 && (
          <div class="empty" style="padding: 48px 24px;">
            <div class="empty__title">Aucune conversation</div>
            <div class="empty__sub">Les échanges des visiteurs avec Marie apparaîtront ici.</div>
          </div>
        )}
        {conversations.map(({ conversation, lastMessage }) => (
          <a
            class={`convo-item${conversation.id === activeId ? " is-active" : ""}`}
            href={`/admin/messages?c=${encodeURIComponent(conversation.id)}`}
          >
            <div class="convo-item__avatar">
              {conversation.visitorName ? conversation.visitorName.slice(0, 2).toUpperCase() : "??"}
            </div>
            <div class="convo-item__body">
              <div class="convo-item__head">
                <span class="convo-item__name">{conversation.visitorName ?? "Visiteur anonyme"}</span>
                <span class="convo-item__time">{formatTime(conversation.lastMessageAt)}</span>
              </div>
              <div class="convo-item__preview">
                {lastMessage ? (
                  <>
                    {lastMessage.direction === "out" && (
                      <span style="color: var(--ink-4);">{lastMessage.author === "marie" ? "Marie · " : "Vous · "}</span>
                    )}
                    {lastMessage.body.slice(0, 80)}
                  </>
                ) : (
                  <span style="color: var(--ink-4);">Aucun message</span>
                )}
              </div>
              <div class="convo-item__source">
                {conversation.channel} · {STATUS_LABELS[conversation.status]}
              </div>
            </div>
            {conversation.unreadCount > 0 && conversation.id !== activeId && (
              <div class="convo-item__dot"></div>
            )}
          </a>
        ))}
      </div>
    </div>

    <div class="convo__panel">
      {active ? (
        <>
          <div class="convo__panel-head">
            <div class="convo-item__avatar" style="width: 38px; height: 38px;">
              {active.visitorName ? active.visitorName.slice(0, 2).toUpperCase() : "??"}
            </div>
            <div style="min-width: 0;">
              <div style="font-family: var(--font-serif); font-size: 16px; color: var(--ink); font-weight: 500;">
                {active.visitorName ?? "Visiteur anonyme"}
              </div>
              <div style="font-size: 12px; color: var(--ink-3);">
                ID <code style="font-family: ui-monospace, monospace; font-size: 11px;">{active.id.slice(0, 8)}…</code>
                · Démarrée {formatTime(active.createdAt)}
              </div>
            </div>
            <div class="row-actions" style="margin-left: auto;">
              <span class={`badge ${active.status === "ouvert" ? "badge--ongoing" : active.status === "en_cours" ? "badge--new" : "badge--paused"}`} id="status-badge">
                {STATUS_LABELS[active.status]}
              </span>
              {active.status !== "en_cours" ? (
                <button class="btn-admin btn-admin--primary" id="take-over-btn" style="padding: 6px 14px; font-size: 12px;">
                  Je prends la main
                </button>
              ) : (
                <button class="btn-admin btn-admin--ghost" id="give-back-btn" style="padding: 6px 14px; font-size: 12px;">
                  Rendre la main à Marie
                </button>
              )}
            </div>
          </div>
          <div class="convo__messages" id="msg-stream">
            {messages.map((m) => (
              <Fragment>
                {m.direction === "in" ? (
                  <div class="convo__msg convo__msg--in" data-mid={m.id}>{m.body}</div>
                ) : (
                  <div class="convo__msg convo__msg--out" data-mid={m.id}>{m.body}</div>
                )}
                <div
                  class="convo__msg-time"
                  style={m.direction === "in" ? "align-self: flex-start;" : "align-self: flex-end;"}
                >
                  {m.author === "marie" ? "Marie · " : m.author === "visitor" ? "Visiteur · " : "Vous · "}
                  {formatTime(m.createdAt)}
                </div>
              </Fragment>
            ))}
          </div>
          <div class="convo__compose">
            <div class="convo__compose-row">
              <textarea id="reply-input" placeholder={active.status === "en_cours" ? "Tapez votre message…" : "Marie répond. Cliquez « Je prends la main » pour intervenir."} rows="2"></textarea>
              <button class="btn-admin btn-admin--primary" id="reply-send" style="padding: 8px 16px;">Envoyer</button>
            </div>
          </div>
        </>
      ) : (
        <div class="empty" style="padding: 80px 24px;">
          <div class="empty__title">Sélectionnez une conversation</div>
          <div class="empty__sub">À gauche, choisissez la conversation à consulter ou à reprendre.</div>
        </div>
      )}
    </div>
  </div>

  {active && (
    <script is:inline define:vars={{ convId: active.id, currentStatus: active.status }}>
      const stream = document.getElementById("msg-stream");
      const inputEl = document.getElementById("reply-input");
      const sendBtn = document.getElementById("reply-send");
      const statusBadge = document.getElementById("status-badge");

      function scrollDown() { stream.scrollTop = stream.scrollHeight; }
      scrollDown();

      function appendMessage(m, direction) {
        const bubble = document.createElement("div");
        bubble.className = "convo__msg " + (direction === "in" ? "convo__msg--in" : "convo__msg--out");
        bubble.dataset.mid = m.id;
        bubble.textContent = m.body;
        stream.appendChild(bubble);
        const time = document.createElement("div");
        time.className = "convo__msg-time";
        time.style.alignSelf = direction === "in" ? "flex-start" : "flex-end";
        const author = m.author === "marie" ? "Marie · " : m.author === "visitor" ? "Visiteur · " : "Vous · ";
        time.textContent = author + new Date(m.createdAt).toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" }).replace(":", "h");
        stream.appendChild(time);
        scrollDown();
      }

      sendBtn.addEventListener("click", async () => {
        const text = inputEl.value.trim();
        if (!text) return;
        sendBtn.disabled = true;
        const r = await fetch("/api/admin/conversations/" + encodeURIComponent(convId) + "/messages", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ text }),
        });
        if (!r.ok) { alert("Échec d'envoi (" + r.status + ")."); sendBtn.disabled = false; return; }
        const data = await r.json();
        inputEl.value = "";
        sendBtn.disabled = false;
        appendMessage(data.message, "out");
      });
      inputEl.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendBtn.click(); }
      });

      const takeBtn = document.getElementById("take-over-btn");
      const giveBtn = document.getElementById("give-back-btn");
      async function setStatus(newStatus) {
        const r = await fetch("/api/admin/conversations/" + encodeURIComponent(convId), {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ status: newStatus }),
        });
        if (!r.ok) { alert("Échec."); return; }
        window.location.reload();
      }
      takeBtn?.addEventListener("click", () => setStatus("en_cours"));
      giveBtn?.addEventListener("click", () => setStatus("ouvert"));

      // Light auto-refresh: pull new messages every 5s.
      let lastRefresh = new Date().toISOString();
      setInterval(async () => {
        try {
          const r = await fetch("/api/admin/conversations/" + encodeURIComponent(convId) + "?markRead=1");
          if (!r.ok) return;
          const data = await r.json();
          const known = new Set(Array.from(stream.querySelectorAll("[data-mid]")).map((el) => el.dataset.mid));
          for (const m of data.messages) {
            if (known.has(m.id)) continue;
            appendMessage(m, m.direction);
          }
          lastRefresh = new Date().toISOString();
        } catch {}
      }, 5000);
    </script>
  )}
</AdminLayout>
