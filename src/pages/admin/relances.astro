---
export const prerender = false;
import AdminLayout from "~/layouts/AdminLayout.astro";
import { documentsRepo } from "@features/documents/infra/repository.ts";
import { clientsRepo } from "@features/clients/infra/repository.ts";
import { initialsOf } from "@features/clients/domain/types.ts";
import { formatEur } from "@features/documents/domain/types.ts";
import { computeCandidates, suggestMessage } from "@features/relances/domain/types.ts";
import type { Urgency } from "@features/relances/domain/types.ts";

const documents = documentsRepo().list();
const clients = clientsRepo().list();
const candidates = computeCandidates(documents, clients);

const counts = {
  total: candidates.length,
  high: candidates.filter((c) => c.urgency === "high").length,
  med: candidates.filter((c) => c.urgency === "med").length,
};

const activeId = Astro.url.searchParams.get("c") ?? candidates[0]?.id ?? null;
const active = activeId ? candidates.find((c) => c.id === activeId) ?? null : null;
const suggested = active ? suggestMessage(active) : "";

function urgencyClass(u: Urgency): string {
  return `relance-card__urgency relance-card__urgency--${u === "high" ? "high" : u === "med" ? "med" : "low"}`;
}
function urgencyLabel(u: Urgency): string {
  return u === "high" ? "Urgent" : u === "med" ? "À planifier" : "Moins urgent";
}
---

<AdminLayout
  title="Relances IA — Maison Fwurtz Admin"
  active="relances"
  breadcrumb="Relances IA"
  screenLabel="Admin · Relances"
>
  <div class="admin-page-head">
    <div>
      <h1 class="admin-page-head__title">Relances <em>IA</em></h1>
      <p class="admin-page-head__sub">
        {counts.total} relance{counts.total > 1 ? "s" : ""} suggérée{counts.total > 1 ? "s" : ""}
        · <strong style="color: #E67878;">{counts.high} urgente{counts.high > 1 ? "s" : ""}</strong>
        · {counts.med} à planifier
      </p>
    </div>
    <div class="admin-page-head__actions">
      <a class="btn-admin btn-admin--ghost" href="/admin/facturation">Voir factures →</a>
    </div>
  </div>

  {candidates.length === 0 ? (
    <div class="card">
      <div class="card__body">
        <div class="empty">
          <div class="empty__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <polygon points="12 2 15 9 22 12 15 15 12 22 9 15 2 12 9 9" />
            </svg>
          </div>
          <div class="empty__title">Aucune relance suggérée</div>
          <div class="empty__sub">Tous vos devis et factures sont à jour. Marie revient dès qu'une relance sera utile.</div>
        </div>
      </div>
    </div>
  ) : (
    <div class="relance-grid">
      <div>
        {candidates.map((c) => (
          <a
            class={`relance-card${c.id === activeId ? " is-active" : ""}`}
            href={`/admin/relances?c=${encodeURIComponent(c.id)}`}
            style="display: block; margin-bottom: 12px; text-decoration: none; color: inherit;"
          >
            <div class="relance-card__head">
              <div class="tbl__avatar" style="width: 32px; height: 32px;">{initialsOf(c.client.name)}</div>
              <div style="flex: 1; min-width: 0;">
                <div style="font-family: var(--font-serif); font-size: 14.5px; color: var(--ink); font-weight: 500;">
                  {c.client.name}
                </div>
                <div class={urgencyClass(c.urgency)}>{urgencyLabel(c.urgency)} · {c.suggestedTone}</div>
              </div>
            </div>
            <div class="relance-card__body">{c.reason}</div>
            <div class="relance-card__foot">
              <span style="color: var(--gold); font-family: ui-monospace, monospace;">{c.document.number}</span>
              <span style="font-family: var(--font-serif); font-style: italic; color: var(--gold);">
                {formatEur(c.document.amountTtcCents)}
              </span>
            </div>
          </a>
        ))}
      </div>

      <div>
        {active ? (
          <div class="ai-suggest">
            <div class="ai-suggest__head">
              <div>
                <div class="ai-suggest__title">Message <em>suggéré</em></div>
                <div style="font-size: 12.5px; color: var(--ink-3); margin-top: 4px;">
                  {active.document.type === "devis" ? "Devis" : "Facture"} {active.document.number}
                  · pour {active.client.name}
                </div>
              </div>
              <div>
                <span class={urgencyClass(active.urgency)}>{urgencyLabel(active.urgency)}</span>
              </div>
            </div>

            <div class="ai-options">
              <div class="ai-option is-selected">
                <div class="ai-option__tone">Ton {active.suggestedTone}</div>
                <div class="ai-option__text" id="suggested-text" style="white-space: pre-line;">{suggested}</div>
              </div>
            </div>

            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              <a class="btn-admin btn-admin--primary" href={`mailto:${active.client.email ?? ""}?subject=${encodeURIComponent("Suivi " + active.document.number)}&body=${encodeURIComponent(suggested)}`}>
                ✉ Envoyer par email
              </a>
              <button class="btn-admin btn-admin--ghost" id="copy-only-btn">Copier le texte</button>
              <a class="btn-admin btn-admin--ghost" href={`/admin/facturation/${active.document.id}`}>Voir le document →</a>
              <button class="btn-admin btn-admin--ghost" id="mark-done-btn" style="margin-left: auto;">
                Marquer relancé
              </button>
            </div>

            <div style="margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--admin-line-soft); font-size: 12px; color: var(--ink-4);">
              <strong style="color: var(--gold);">Marie observe :</strong> {active.reason}.
              Le ton suggéré est <em>{active.suggestedTone}</em> en fonction du délai écoulé et du statut.
            </div>
          </div>
        ) : (
          <div class="ai-suggest">
            <div style="font-size: 14px; color: var(--ink-3);">Sélectionnez une suggestion à gauche.</div>
          </div>
        )}
      </div>
    </div>
  )}

  {active && (
    <script is:inline define:vars={{ docId: active.document.id, suggestedText: suggested }}>
      document.getElementById("copy-only-btn")?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(suggestedText);
          const b = document.getElementById("copy-only-btn");
          const o = b.textContent; b.textContent = "✓ Copié";
          setTimeout(() => b.textContent = o, 1500);
        } catch {
          alert("Copie impossible — sélectionnez le texte manuellement.");
        }
      });
      document.getElementById("mark-done-btn")?.addEventListener("click", async () => {
        const note = "Relancé le " + new Date().toLocaleDateString("fr-FR");
        const r = await fetch("/api/admin/documents/" + encodeURIComponent(docId), {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ notes: note }),
        });
        if (!r.ok) { alert("Échec."); return; }
        document.querySelector(".relance-card.is-active")?.remove();
        window.location.href = "/admin/relances";
      });
    </script>
  )}
</AdminLayout>
