---
export const prerender = false;
import AdminLayout from "~/layouts/AdminLayout.astro";

const body = `

  <svg width="0" height="0" style="position:absolute"><defs>
    <linearGradient id="kpi-grad" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#D4AF7A" stop-opacity="0.4"/><stop offset="100%" stop-color="#D4AF7A" stop-opacity="0"/></linearGradient>
    <linearGradient id="chart-grad" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#D4AF7A" stop-opacity="0.35"/><stop offset="100%" stop-color="#D4AF7A" stop-opacity="0"/></linearGradient>
  </defs></svg>

  <div class="admin-page-head">
    <div>
      <h1 class="admin-page-head__title">Statistiques <em>détaillées</em></h1>
      <p class="admin-page-head__sub">Du 16 avril au 15 mai 2026 · données mises à jour il y a 4 minutes</p>
    </div>
    <div class="admin-page-head__actions">
      <div class="tabs">
        <button class="tabs__tab">7j</button>
        <button class="tabs__tab is-active">30j</button>
        <button class="tabs__tab">90j</button>
        <button class="tabs__tab">12 mois</button>
      </div>
      <button class="btn-admin btn-admin--ghost"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Exporter</button>
    </div>
  </div>

  <!-- KPI row -->
  <div class="kpi-grid">
    <div class="kpi">
      <div class="kpi__head"><span class="kpi__label">Visiteurs uniques</span><span class="kpi__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21 C4 16 8 14 12 14 C16 14 20 16 20 21"/></svg></span></div>
      <div class="kpi__value">2&nbsp;<em>847</em></div>
      <div class="kpi__delta kpi__delta--up"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5V19"/><path d="M5 12L12 5L19 12"/></svg> +18,4 %</div>
    </div>
    <div class="kpi">
      <div class="kpi__head"><span class="kpi__label">Sessions</span><span class="kpi__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 14"/></svg></span></div>
      <div class="kpi__value">4&nbsp;<em>231</em></div>
      <div class="kpi__delta kpi__delta--up"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5V19"/><path d="M5 12L12 5L19 12"/></svg> +12,1 %</div>
    </div>
    <div class="kpi">
      <div class="kpi__head"><span class="kpi__label">Durée moyenne</span><span class="kpi__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 14"/></svg></span></div>
      <div class="kpi__value"><em>2′47</em></div>
      <div class="kpi__delta kpi__delta--up"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5V19"/><path d="M5 12L12 5L19 12"/></svg> +14 sec</div>
    </div>
    <div class="kpi">
      <div class="kpi__head"><span class="kpi__label">Taux de conversion</span><span class="kpi__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/></svg></span></div>
      <div class="kpi__value"><em>4,2</em>&nbsp;%</div>
      <div class="kpi__delta kpi__delta--down"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5V19"/><path d="M19 12L12 19L5 12"/></svg> −0,3 pt</div>
    </div>
  </div>

  <!-- Main chart -->
  <div class="card" style="margin-bottom: 16px;">
    <div class="card__head">
      <div>
        <h3 class="card__title">Trafic <em>quotidien</em></h3>
        <div class="card__sub">Visiteurs uniques et conversions sur 30 jours</div>
      </div>
      <div class="tabs">
        <button class="tabs__tab is-active">Visiteurs</button>
        <button class="tabs__tab">Sessions</button>
        <button class="tabs__tab">Pages vues</button>
      </div>
    </div>
    <div class="chart-legend">
      <span class="chart-legend__item"><span class="chart-legend__dot"></span>Visiteurs · 30j</span>
      <span class="chart-legend__item"><span class="chart-legend__dot chart-legend__dot--alt"></span>30j précédents</span>
    </div>
    <div class="chart-wrap" style="height: 320px;">
      <svg class="chart-svg" viewBox="0 0 800 280" preserveAspectRatio="none">
        <line class="grid" x1="0" y1="40" x2="800" y2="40"/>
        <line class="grid" x1="0" y1="100" x2="800" y2="100"/>
        <line class="grid" x1="0" y1="160" x2="800" y2="160"/>
        <line class="grid" x1="0" y1="220" x2="800" y2="220"/>

        <text class="axis" x="0" y="34">120</text>
        <text class="axis" x="0" y="94">90</text>
        <text class="axis" x="0" y="154">60</text>
        <text class="axis" x="0" y="214">30</text>

        <!-- Previous period faded -->
        <path style="fill:none; stroke:#8AB4E8; stroke-width:1.5; opacity:0.4; stroke-dasharray: 4 4;" d="M0,170 L40,160 L80,180 L120,150 L160,170 L200,140 L240,160 L280,130 L320,150 L360,120 L400,140 L440,110 L480,130 L520,100 L560,120 L600,90 L640,110 L680,80 L720,100 L760,70 L800,80"/>

        <!-- Current period area + line -->
        <path class="area" d="M0,200 L40,180 L80,190 L120,150 L160,170 L200,120 L240,140 L280,100 L320,120 L360,80 L400,110 L440,90 L480,60 L520,90 L560,70 L600,50 L640,80 L680,60 L720,40 L760,55 L800,30 L800,280 L0,280 Z"/>
        <path class="line" style="stroke-width:2.5;" d="M0,200 L40,180 L80,190 L120,150 L160,170 L200,120 L240,140 L280,100 L320,120 L360,80 L400,110 L440,90 L480,60 L520,90 L560,70 L600,50 L640,80 L680,60 L720,40 L760,55 L800,30"/>

        <!-- Dots -->
        <circle class="dot-ring" cx="800" cy="30" r="7"/>
        <circle class="dot" cx="800" cy="30" r="4"/>

        <text class="axis" x="0" y="270">16 avr</text>
        <text class="axis" x="240" y="270">25 avr</text>
        <text class="axis" x="480" y="270">5 mai</text>
        <text class="axis" x="740" y="270">15 mai</text>
      </svg>
    </div>
  </div>

  <!-- Two columns: top pages + devices -->
  <div class="cols-2" style="margin-bottom: 16px;">
    <div class="card">
      <div class="card__head">
        <div>
          <h3 class="card__title">Pages <em>les plus visitées</em></h3>
          <div class="card__sub">Top 6 du dernier mois</div>
        </div>
      </div>
      <div class="card__body card__body--flush">
        <table class="tbl">
          <thead><tr><th>Page</th><th>Visites</th><th>Durée moy.</th><th>Conversion</th></tr></thead>
          <tbody>
            <tr><td><strong style="color: var(--ink);">/</strong><br><span style="font-size: 11px; color: var(--ink-4);">Accueil</span></td><td style="color: var(--gold); font-family: ui-monospace, monospace;">1 247</td><td>3′12</td><td><span style="color: #6BCB77;">5,8 %</span></td></tr>
            <tr><td><strong style="color: var(--ink);">/services/creation-sites-web</strong></td><td style="color: var(--gold); font-family: ui-monospace, monospace;">847</td><td>4′22</td><td><span style="color: #6BCB77;">8,2 %</span></td></tr>
            <tr><td><strong style="color: var(--ink);">/services/evenementiel</strong></td><td style="color: var(--gold); font-family: ui-monospace, monospace;">678</td><td>4′01</td><td><span style="color: #6BCB77;">7,4 %</span></td></tr>
            <tr><td><strong style="color: var(--ink);">/services/gestion-administrative</strong></td><td style="color: var(--gold); font-family: ui-monospace, monospace;">523</td><td>3′28</td><td><span style="color: #6BCB77;">6,3 %</span></td></tr>
            <tr><td><strong style="color: var(--ink);">/a-propos</strong></td><td style="color: var(--gold); font-family: ui-monospace, monospace;">446</td><td>2′55</td><td><span style="color: var(--gold);">3,1 %</span></td></tr>
            <tr><td><strong style="color: var(--ink);">/services/accompagnement-juridique</strong></td><td style="color: var(--gold); font-family: ui-monospace, monospace;">389</td><td>4′47</td><td><span style="color: #6BCB77;">9,1 %</span></td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div style="display: grid; gap: 16px;">
      <div class="card">
        <div class="card__head">
          <div><h3 class="card__title">Sources de <em>trafic</em></h3></div>
        </div>
        <div class="card__body card__body--flush">
          <div class="bar-list">
            <div class="bar-row"><span class="bar-label">Recherche organique</span><div class="bar-track"><div class="bar-fill" style="width:64%"></div></div><span class="bar-value">64%</span></div>
            <div class="bar-row"><span class="bar-label">LinkedIn</span><div class="bar-track"><div class="bar-fill" style="width:18%"></div></div><span class="bar-value">18%</span></div>
            <div class="bar-row"><span class="bar-label">Direct</span><div class="bar-track"><div class="bar-fill" style="width:12%"></div></div><span class="bar-value">12%</span></div>
            <div class="bar-row"><span class="bar-label">Instagram</span><div class="bar-track"><div class="bar-fill" style="width:4%"></div></div><span class="bar-value">4%</span></div>
            <div class="bar-row"><span class="bar-label">Référents</span><div class="bar-track"><div class="bar-fill" style="width:2%"></div></div><span class="bar-value">2%</span></div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card__head">
          <div><h3 class="card__title">Appareils <em>utilisés</em></h3></div>
        </div>
        <div class="card__body" style="padding: 32px 24px;">
          <div style="display: flex; align-items: center; justify-content: center; gap: 32px;">
            <!-- Donut -->
            <svg width="140" height="140" viewBox="0 0 140 140">
              <circle cx="70" cy="70" r="55" fill="none" stroke="var(--admin-surface-3)" stroke-width="18"/>
              <circle cx="70" cy="70" r="55" fill="none" stroke="#D4AF7A" stroke-width="18" stroke-dasharray="216 346" transform="rotate(-90 70 70)" stroke-linecap="round"/>
              <circle cx="70" cy="70" r="55" fill="none" stroke="#8AB4E8" stroke-width="18" stroke-dasharray="100 346" stroke-dashoffset="-216" transform="rotate(-90 70 70)" stroke-linecap="round" opacity="0.7"/>
              <text x="70" y="68" text-anchor="middle" font-family="Cormorant Garamond" font-size="24" font-weight="500" font-style="italic" fill="#D4AF7A">62%</text>
              <text x="70" y="84" text-anchor="middle" font-size="9" fill="rgba(255,255,255,0.6)" letter-spacing="0.16em">DESKTOP</text>
            </svg>
            <div style="display: grid; gap: 14px;">
              <div style="display: flex; align-items: center; gap: 10px;"><span style="width: 10px; height: 10px; border-radius: 999px; background: var(--gold);"></span><span style="font-size: 13px; color: var(--ink-2);">Desktop · <strong style="color: var(--gold); font-family: ui-monospace, monospace;">62%</strong></span></div>
              <div style="display: flex; align-items: center; gap: 10px;"><span style="width: 10px; height: 10px; border-radius: 999px; background: #8AB4E8;"></span><span style="font-size: 13px; color: var(--ink-2);">Mobile · <strong style="color: #8AB4E8; font-family: ui-monospace, monospace;">29%</strong></span></div>
              <div style="display: flex; align-items: center; gap: 10px;"><span style="width: 10px; height: 10px; border-radius: 999px; background: var(--admin-surface-3);"></span><span style="font-size: 13px; color: var(--ink-2);">Tablette · <strong style="color: var(--ink-3); font-family: ui-monospace, monospace;">9%</strong></span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Conversion funnel -->
  <div class="card">
    <div class="card__head">
      <div>
        <h3 class="card__title">Entonnoir de <em>conversion</em></h3>
        <div class="card__sub">Du visiteur au rendez-vous · 30 derniers jours</div>
      </div>
    </div>
    <div class="card__body" style="padding: 32px 40px;">
      <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; align-items: end;">

        <div style="text-align: center;">
          <div style="height: 220px; background: linear-gradient(180deg, var(--gold) 0%, var(--gold-press) 100%); border-radius: 8px 8px 4px 4px; position: relative; padding: 16px 20px;">
            <div style="font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(8,17,30,0.6); font-weight: 500;">Étape 1</div>
            <div style="font-family: var(--font-serif); font-size: 32px; color: var(--admin-bg); font-weight: 500; line-height: 1; margin-top: 8px;">2&nbsp;847</div>
            <div style="font-size: 11px; color: rgba(8,17,30,0.7); margin-top: 4px;">visiteurs uniques</div>
          </div>
          <div style="font-size: 12px; color: var(--ink-3); margin-top: 8px;">Visite du site</div>
        </div>

        <div style="text-align: center;">
          <div style="height: 168px; background: linear-gradient(180deg, var(--gold) 0%, var(--gold-press) 100%); border-radius: 8px 8px 4px 4px; position: relative; padding: 14px 16px; opacity: 0.85;">
            <div style="font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(8,17,30,0.6); font-weight: 500;">Étape 2</div>
            <div style="font-family: var(--font-serif); font-size: 28px; color: var(--admin-bg); font-weight: 500; line-height: 1; margin-top: 8px;">1&nbsp;132</div>
            <div style="font-size: 11px; color: rgba(8,17,30,0.7); margin-top: 4px;">→ 39,8 %</div>
          </div>
          <div style="font-size: 12px; color: var(--ink-3); margin-top: 8px;">Page service consultée</div>
        </div>

        <div style="text-align: center;">
          <div style="height: 110px; background: linear-gradient(180deg, var(--gold) 0%, var(--gold-press) 100%); border-radius: 8px 8px 4px 4px; position: relative; padding: 12px 14px; opacity: 0.7;">
            <div style="font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(8,17,30,0.6); font-weight: 500;">Étape 3</div>
            <div style="font-family: var(--font-serif); font-size: 24px; color: var(--admin-bg); font-weight: 500; line-height: 1; margin-top: 6px;">347</div>
            <div style="font-size: 11px; color: rgba(8,17,30,0.7); margin-top: 4px;">→ 12,2 %</div>
          </div>
          <div style="font-size: 12px; color: var(--ink-3); margin-top: 8px;">Conciergerie ouverte</div>
        </div>

        <div style="text-align: center;">
          <div style="height: 82px; background: linear-gradient(180deg, var(--gold) 0%, var(--gold-press) 100%); border-radius: 8px 8px 4px 4px; padding: 10px 12px; opacity: 0.55;">
            <div style="font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(8,17,30,0.6); font-weight: 500;">Étape 4</div>
            <div style="font-family: var(--font-serif); font-size: 20px; color: var(--admin-bg); font-weight: 500; line-height: 1; margin-top: 4px;">189</div>
            <div style="font-size: 10px; color: rgba(8,17,30,0.7); margin-top: 2px;">→ 6,6 %</div>
          </div>
          <div style="font-size: 12px; color: var(--ink-3); margin-top: 8px;">Conversation engagée</div>
        </div>

        <div style="text-align: center;">
          <div style="height: 54px; background: linear-gradient(180deg, var(--gold) 0%, var(--gold-press) 100%); border-radius: 8px 8px 4px 4px; padding: 8px 12px; opacity: 0.4;">
            <div style="font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(8,17,30,0.6); font-weight: 500;">Étape 5</div>
            <div style="font-family: var(--font-serif); font-size: 16px; color: var(--admin-bg); font-weight: 500; line-height: 1; margin-top: 2px;">12</div>
          </div>
          <div style="font-size: 12px; color: var(--gold); margin-top: 8px; font-weight: 500;">RDV confirmé · 4,2 %</div>
        </div>

      </div>
    </div>
  </div>`;
---

<AdminLayout
  title="Statistiques — Maison Fwurtz Admin" active="stats"
  breadcrumb="Statistiques"
  screenLabel="Admin · Statistiques"
>
  <Fragment set:html={body} />
</AdminLayout>
