---
export const prerender = false;
import AdminLayout from "~/layouts/AdminLayout.astro";
import { pagesRepo } from "@features/pages/infra/repository.ts";

const allPages = pagesRepo().list();
const activeSlug = Astro.url.searchParams.get("p") ?? allPages[0]?.slug ?? "";
const active = allPages.find((p) => p.slug === activeSlug) ?? allPages[0] ?? null;
---

<AdminLayout
  title="Pages — Maison Fwurtz Admin"
  active="contenus"
  breadcrumb="Pages"
  screenLabel="Admin · Pages"
>
  <div class="admin-page-head">
    <div>
      <h1 class="admin-page-head__title">Édition <em>de page</em></h1>
      <p class="admin-page-head__sub">
        Choisissez une page à gauche pour éditer ses métadonnées (titre, description SEO).
      </p>
    </div>
    <div class="admin-page-head__actions">
      {active && (
        <>
          <a class="btn-admin btn-admin--ghost" href={active.slug === "index" ? "/" : `/${active.slug}`} target="_blank" rel="noopener">Prévisualiser →</a>
          <button class="btn-admin btn-admin--primary" id="save-btn">Enregistrer</button>
        </>
      )}
    </div>
  </div>

  <div class="content-grid">
    <aside class="content-nav">
      {allPages.map((p) => (
        <a
          class={`content-nav__item${p.slug === activeSlug ? " is-active" : ""}`}
          href={`/admin/contenus?p=${encodeURIComponent(p.slug)}`}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 3 H15 L19 7 V21 H6 Z" />
            <polyline points="15 3 15 7 19 7" />
          </svg>
          <span>{p.title}</span>
        </a>
      ))}
    </aside>

    {active ? (
      <div>
        <div class="editor-section">
          <div class="editor-section__head">
            <div class="editor-section__title">Métadonnées <em>& SEO</em></div>
            <div class="editor-section__hint">Visible dans Google et lors du partage</div>
          </div>
          <div class="form-grid">
            <div class="form-row">
              <div>
                <div class="form-label">URL</div>
                <div class="form-help">Adresse publique (lecture seule)</div>
              </div>
              <div>
                <input class="input-admin" type="text" value={active.slug === "index" ? "/" : `/${active.slug}`} disabled style="opacity: 0.6;" />
              </div>
            </div>
            <div class="form-row">
              <div>
                <div class="form-label">Titre du navigateur</div>
                <div class="form-help">55 à 65 caractères idéalement.</div>
              </div>
              <div>
                <input class="input-admin" id="f-title" type="text" value={active.title} />
                <div style="font-size: 11px; color: var(--ink-4); margin-top: 6px;">
                  <span id="f-title-count">{active.title.length}</span> / 65 caractères
                </div>
              </div>
            </div>
            <div class="form-row">
              <div>
                <div class="form-label">Description</div>
                <div class="form-help">155 caractères max. Apparaît sous le titre dans Google.</div>
              </div>
              <div>
                <textarea class="input-admin" id="f-desc" rows="3">{active.metaDescription ?? ""}</textarea>
                <div style="font-size: 11px; color: var(--ink-4); margin-top: 6px;">
                  <span id="f-desc-count">{(active.metaDescription ?? "").length}</span> / 155 caractères
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="editor-section">
          <div class="editor-section__head">
            <div class="editor-section__title">Bandeau <em>d'ouverture</em></div>
            <div class="editor-section__hint">Premier impact visuel</div>
          </div>
          <div class="form-grid">
            <div class="form-row">
              <div>
                <div class="form-label">Titre principal</div>
                <div class="form-help">Le hero de la page</div>
              </div>
              <div>
                <input class="input-admin" id="f-hero-title" type="text" value={(active.blocks?.hero?.title as string) ?? ""} placeholder="Maison Fwurtz, votre alliée…" />
              </div>
            </div>
            <div class="form-row">
              <div>
                <div class="form-label">Sous-titre</div>
              </div>
              <div>
                <input class="input-admin" id="f-hero-subtitle" type="text" value={(active.blocks?.hero?.subtitle as string) ?? ""} />
              </div>
            </div>
            <div class="form-row">
              <div>
                <div class="form-label">Texte CTA</div>
                <div class="form-help">Bouton principal du bandeau</div>
              </div>
              <div>
                <input class="input-admin" id="f-hero-cta" type="text" value={(active.blocks?.hero?.cta as string) ?? ""} placeholder="Découvrir nos services" />
              </div>
            </div>
          </div>
        </div>

        <div style="font-size: 12px; color: var(--ink-4); padding: 12px 0;">
          Dernière mise à jour : {active.updatedAt.slice(0, 16).replace("T", " ")}
          {active.publishedAt && (
            <> · <span style="color: #6BCB77;">● Publié</span></>
          )}
        </div>
      </div>
    ) : (
      <div class="empty">
        <div class="empty__title">Aucune page</div>
      </div>
    )}
  </div>

  {active && (
    <script is:inline define:vars={{ pageId: active.id }}>
      const get = (id) => document.getElementById(id);
      const titleEl = get("f-title");
      const descEl = get("f-desc");
      titleEl.addEventListener("input", () => get("f-title-count").textContent = titleEl.value.length);
      descEl.addEventListener("input", () => get("f-desc-count").textContent = descEl.value.length);

      get("save-btn").addEventListener("click", async () => {
        const btn = get("save-btn");
        const orig = btn.textContent;
        btn.disabled = true; btn.textContent = "Enregistrement…";
        const payload = {
          title: titleEl.value.trim(),
          metaDescription: descEl.value.trim() || null,
          blocks: {
            hero: {
              title: get("f-hero-title").value.trim(),
              subtitle: get("f-hero-subtitle").value.trim(),
              cta: get("f-hero-cta").value.trim(),
            },
          },
          publish: true,
        };
        const r = await fetch("/api/admin/pages/" + encodeURIComponent(pageId), {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!r.ok) { btn.disabled = false; btn.textContent = orig; alert("Échec d'enregistrement."); return; }
        btn.textContent = "✓ Enregistré";
        setTimeout(() => { btn.disabled = false; btn.textContent = orig; }, 1500);
      });
    </script>
  )}
</AdminLayout>
