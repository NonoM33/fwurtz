---
export const prerender = false;
import AdminLayout from "~/layouts/AdminLayout.astro";
import { pagesRepo } from "@features/pages/infra/repository.ts";

const allPages = pagesRepo().list();
const initialSlug = Astro.url.searchParams.get("p") ?? allPages[0]?.slug ?? "";
const active = allPages.find((p) => p.slug === initialSlug) ?? allPages[0] ?? null;
---

<AdminLayout
  title="Pages — Maison Fwurtz Admin"
  active="contenus"
  breadcrumb="Pages"
  screenLabel="Admin · Pages"
>
  <div class="admin-page-head">
    <div>
      <h1 class="admin-page-head__title">Édition <em>de page</em></h1>
      <p class="admin-page-head__sub">
        Choisissez une page à gauche pour éditer ses métadonnées (titre, description SEO).
      </p>
    </div>
    <div class="admin-page-head__actions">
      {active && (
        <>
          <a class="btn-admin btn-admin--ghost" id="preview-link" href={active.slug === "index" ? "/" : `/${active.slug}`} target="_blank" rel="noopener">Prévisualiser →</a>
          <button class="btn-admin btn-admin--primary" id="save-btn">Enregistrer</button>
        </>
      )}
    </div>
  </div>

  <div class="content-grid">
    <aside class="content-nav">
      {allPages.map((p) => (
        <a
          class={`content-nav__item${p.id === active?.id ? " is-active" : ""}`}
          href={`/admin/contenus?p=${encodeURIComponent(p.slug)}`}
          data-page-id={p.id}
          data-page-slug={p.slug}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 3 H15 L19 7 V21 H6 Z" />
            <polyline points="15 3 15 7 19 7" />
          </svg>
          <span>{p.title}</span>
        </a>
      ))}
    </aside>

    {active ? (
      <div id="page-editor">
        <div class="editor-section">
          <div class="editor-section__head">
            <div class="editor-section__title">Métadonnées <em>& SEO</em></div>
            <div class="editor-section__hint">Visible dans Google et lors du partage</div>
          </div>
          <div class="form-grid">
            <div class="form-row">
              <div>
                <div class="form-label">URL</div>
                <div class="form-help">Adresse publique (lecture seule)</div>
              </div>
              <div>
                <input class="input-admin" id="f-url" type="text" value={active.slug === "index" ? "/" : `/${active.slug}`} disabled style="opacity: 0.6;" />
              </div>
            </div>
            <div class="form-row">
              <div>
                <div class="form-label">Titre du navigateur</div>
                <div class="form-help">55 à 65 caractères idéalement.</div>
              </div>
              <div>
                <input class="input-admin" id="f-title" type="text" value={active.title} />
                <div style="font-size: 11px; color: var(--ink-4); margin-top: 6px;">
                  <span id="f-title-count">{active.title.length}</span> / 65 caractères
                </div>
              </div>
            </div>
            <div class="form-row">
              <div>
                <div class="form-label">Description</div>
                <div class="form-help">155 caractères max. Apparaît sous le titre dans Google.</div>
              </div>
              <div>
                <textarea class="input-admin" id="f-desc" rows="3">{active.metaDescription ?? ""}</textarea>
                <div style="font-size: 11px; color: var(--ink-4); margin-top: 6px;">
                  <span id="f-desc-count">{(active.metaDescription ?? "").length}</span> / 155 caractères
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="editor-section">
          <div class="editor-section__head">
            <div class="editor-section__title">Bandeau <em>d'ouverture</em></div>
            <div class="editor-section__hint">Premier impact visuel</div>
          </div>
          <div class="form-grid">
            <div class="form-row">
              <div>
                <div class="form-label">Titre principal</div>
                <div class="form-help">Le hero de la page</div>
              </div>
              <div>
                <input class="input-admin" id="f-hero-title" type="text" value={(active.blocks?.hero?.title as string) ?? ""} placeholder="Maison Fwurtz, votre alliée…" />
              </div>
            </div>
            <div class="form-row">
              <div>
                <div class="form-label">Sous-titre</div>
              </div>
              <div>
                <input class="input-admin" id="f-hero-subtitle" type="text" value={(active.blocks?.hero?.subtitle as string) ?? ""} />
              </div>
            </div>
            <div class="form-row">
              <div>
                <div class="form-label">Texte CTA</div>
                <div class="form-help">Bouton principal du bandeau</div>
              </div>
              <div>
                <input class="input-admin" id="f-hero-cta" type="text" value={(active.blocks?.hero?.cta as string) ?? ""} placeholder="Découvrir nos services" />
              </div>
            </div>
          </div>
        </div>

        <div id="page-meta" style="font-size: 12px; color: var(--ink-4); padding: 12px 0;">
          Dernière mise à jour : <span id="page-updated">{active.updatedAt.slice(0, 16).replace("T", " ")}</span>
          {active.publishedAt && (
            <> · <span style="color: #6BCB77;">● Publié</span></>
          )}
        </div>
      </div>
    ) : (
      <div class="empty">
        <div class="empty__title">Aucune page</div>
      </div>
    )}
  </div>

  <script is:inline define:vars={{ allPages, initialPageId: active?.id ?? null }}>
    let currentId = initialPageId;

    const get = (id) => document.getElementById(id);
    const titleEl = get("f-title");
    const descEl = get("f-desc");
    const heroTitleEl = get("f-hero-title");
    const heroSubEl = get("f-hero-subtitle");
    const heroCtaEl = get("f-hero-cta");
    const urlEl = get("f-url");
    const updatedEl = get("page-updated");
    const previewLink = get("preview-link");

    function loadPage(p) {
      if (!p) return;
      currentId = p.id;
      titleEl.value = p.title;
      descEl.value = p.metaDescription ?? "";
      heroTitleEl.value = (p.blocks?.hero?.title) ?? "";
      heroSubEl.value = (p.blocks?.hero?.subtitle) ?? "";
      heroCtaEl.value = (p.blocks?.hero?.cta) ?? "";
      urlEl.value = p.slug === "index" ? "/" : "/" + p.slug;
      updatedEl.textContent = p.updatedAt.slice(0, 16).replace("T", " ");
      previewLink.href = p.slug === "index" ? "/" : "/" + p.slug;
      get("f-title-count").textContent = String(titleEl.value.length);
      get("f-desc-count").textContent = String(descEl.value.length);
      // sidebar active state
      document.querySelectorAll("[data-page-id]").forEach((a) => {
        a.classList.toggle("is-active", a.getAttribute("data-page-id") === p.id);
      });
      // URL bar (no reload)
      const url = "/admin/contenus?p=" + encodeURIComponent(p.slug);
      history.pushState({ pageId: p.id }, "", url);
    }

    document.querySelectorAll("[data-page-id]").forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        const id = a.getAttribute("data-page-id");
        const p = allPages.find((x) => x.id === id);
        if (p) loadPage(p);
      });
    });

    window.addEventListener("popstate", (e) => {
      const id = e.state?.pageId;
      if (id) {
        const p = allPages.find((x) => x.id === id);
        if (p) loadPage(p);
      } else {
        // fallback: read ?p= from URL
        const slug = new URL(window.location.href).searchParams.get("p");
        const p = allPages.find((x) => x.slug === slug);
        if (p) loadPage(p);
      }
    });

    titleEl?.addEventListener("input", () => get("f-title-count").textContent = String(titleEl.value.length));
    descEl?.addEventListener("input", () => get("f-desc-count").textContent = String(descEl.value.length));

    get("save-btn")?.addEventListener("click", async () => {
      const btn = get("save-btn");
      const orig = btn.textContent;
      btn.disabled = true; btn.textContent = "Enregistrement…";
      const payload = {
        title: titleEl.value.trim(),
        metaDescription: descEl.value.trim() || null,
        blocks: {
          hero: {
            title: heroTitleEl.value.trim(),
            subtitle: heroSubEl.value.trim(),
            cta: heroCtaEl.value.trim(),
          },
        },
        publish: true,
      };
      const r = await fetch("/api/admin/pages/" + encodeURIComponent(currentId), {
        method: "PATCH",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!r.ok) { btn.disabled = false; btn.textContent = orig; alert("Échec d'enregistrement."); return; }
      const data = await r.json();
      // refresh in-memory copy so subsequent navigation sees the new values
      const idx = allPages.findIndex((x) => x.id === currentId);
      if (idx >= 0) {
        allPages[idx] = {
          ...allPages[idx],
          title: data.page.title,
          metaDescription: data.page.metaDescription,
          blocks: data.page.blocks,
          updatedAt: data.page.updatedAt,
          publishedAt: data.page.publishedAt,
        };
        // Update sidebar label if the title changed
        const sidebarItem = document.querySelector(`[data-page-id="${currentId}"] span`);
        if (sidebarItem) sidebarItem.textContent = data.page.title;
        updatedEl.textContent = data.page.updatedAt.slice(0, 16).replace("T", " ");
      }
      btn.textContent = "✓ Enregistré";
      setTimeout(() => { btn.disabled = false; btn.textContent = orig; }, 1500);
    });
  </script>
</AdminLayout>
