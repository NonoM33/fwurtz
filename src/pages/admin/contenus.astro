---
export const prerender = false;
import AdminLayout from "~/layouts/AdminLayout.astro";

const body = `

  <div class="admin-page-head">
    <div>
      <h1 class="admin-page-head__title">Édition <em>de page</em></h1>
      <p class="admin-page-head__sub">Modifier les contenus des pages publiques. Vos changements sont prévisualisables avant publication.</p>
    </div>
    <div class="admin-page-head__actions">
      <button class="btn-admin btn-admin--ghost"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12 C5 6 9 4 12 4 C15 4 19 6 22 12 C19 18 15 20 12 20 C9 20 5 18 2 12 Z"/><circle cx="12" cy="12" r="3"/></svg> Prévisualiser</button>
      <button class="btn-admin btn-admin--primary" data-save>Enregistrer les changements</button>
    </div>
  </div>

  <div class="content-grid">

    <aside class="content-nav">
      <a class="content-nav__item is-active" href="/admin/contenus"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg> Accueil</a>
      <a class="content-nav__item" href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg> Services</a>
      <a class="content-nav__item" href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21 C4 16 8 14 12 14 C16 14 20 16 20 21"/></svg> À propos</a>
      <a class="content-nav__item" href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="4 12 9 17 20 6"/></svg> Processus</a>
      <a class="content-nav__item" href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg> Contact</a>
      <a class="content-nav__item" href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4 V20 L12 18 L20 20 V4 L12 6 Z"/></svg> Ressources</a>
      <div style="height: 1px; background: var(--admin-line); margin: 12px 8px;"></div>
      <a class="content-nav__item" href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 11.5a8.4 8.4 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.4 8.4 0 01-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.4 8.4 0 013.8-.9h.5a8.5 8.5 0 018 8z"/></svg> Sites web (détail)</a>
      <a class="content-nav__item" href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg> Gestion admin</a>
      <a class="content-nav__item" href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><line x1="12" y1="3" x2="12" y2="21"/><path d="M7 6 L4 13 H10 Z"/></svg> Juridique</a>
      <a class="content-nav__item" href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="7" y="10" width="34" height="30" rx="2" transform="scale(0.5)"/></svg> Événementiel</a>
      <div style="height: 1px; background: var(--admin-line); margin: 12px 8px;"></div>
      <a class="content-nav__item" href="#"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 2 H6 a2 2 0 00-2 2 v16 a2 2 0 002 2 h12 a2 2 0 002-2 V8 Z"/></svg> Mentions légales</a>
    </aside>

    <div>

      <!-- SEO + meta -->
      <div class="editor-section">
        <div class="editor-section__head">
          <div>
            <span class="editor-section__title">Métadonnées <em>& SEO</em></span>
            <span class="editor-section__hint">Visible dans Google et lors du partage</span>
          </div>
          <span class="badge badge--published">Publié · /index.html</span>
        </div>

        <div class="form-grid">
          <div class="form-row">
            <div>
              <div class="form-label">URL</div>
              <div class="form-help">L'adresse publique de la page.</div>
            </div>
            <div>
              <input class="input-admin" value="/" disabled style="opacity: 0.7;">
            </div>
          </div>

          <div class="form-row">
            <div>
              <div class="form-label">Titre du navigateur</div>
              <div class="form-help">55 à 65 caractères idéalement. Apparaît dans l'onglet et les résultats Google.</div>
            </div>
            <div>
              <input class="input-admin" value="Maison Fwurtz — Votre alliée au quotidien">
              <div class="form-help" style="margin-top: 8px;">42 / 65 caractères</div>
            </div>
          </div>

          <div class="form-row">
            <div>
              <div class="form-label">Description</div>
              <div class="form-help">155 caractères max. Apparaît sous le titre dans Google.</div>
            </div>
            <div>
              <textarea class="input-admin" rows="3">Maison Fwurtz : accompagnement sur mesure pour simplifier, structurer et développer vos projets. Web, administratif, juridique, événementiel.</textarea>
              <div class="form-help" style="margin-top: 8px;">143 / 155 caractères · <span style="color: var(--gold);">Optimal</span></div>
            </div>
          </div>
        </div>
      </div>

      <!-- HERO -->
      <div class="editor-section">
        <div class="editor-section__head">
          <div>
            <span class="editor-section__title">Bandeau <em>d'ouverture</em></span>
            <span class="editor-section__hint">Premier impact visuel</span>
          </div>
        </div>

        <div class="form-grid">
          <div class="form-row">
            <div>
              <div class="form-label">Eyebrow</div>
              <div class="form-help">Petit texte en majuscules dorées</div>
            </div>
            <div><input class="input-admin" value="Votre alliée au quotidien"></div>
          </div>

          <div class="form-row">
            <div>
              <div class="form-label">Titre principal</div>
              <div class="form-help">Utilisez des sauts de ligne. Encadrer un mot par * pour l'italique doré.</div>
            </div>
            <div>
              <textarea class="input-admin" rows="3">Maison Fwurtz,
*votre alliée*
au quotidien.</textarea>
            </div>
          </div>

          <div class="form-row">
            <div>
              <div class="form-label">Sous-titre</div>
            </div>
            <div>
              <textarea class="input-admin" rows="2">Des solutions sur mesure pour *simplifier, structurer et développer* vos projets.</textarea>
            </div>
          </div>

          <div class="form-row">
            <div>
              <div class="form-label">Bouton principal</div>
            </div>
            <div>
              <div class="input-group">
                <input class="input-admin" value="Découvrir nos services" placeholder="Libellé">
                <input class="input-admin" value="/services" placeholder="Lien">
              </div>
            </div>
          </div>

          <div class="form-row">
            <div>
              <div class="form-label">Bouton secondaire</div>
            </div>
            <div>
              <div class="input-group">
                <input class="input-admin" value="Réserver un échange" placeholder="Libellé">
                <input class="input-admin" value="#rdv" placeholder="Lien">
              </div>
            </div>
          </div>

          <div class="form-row">
            <div>
              <div class="form-label">Photo de portrait</div>
              <div class="form-help">Format 4:5 idéal. Optimisée automatiquement.</div>
            </div>
            <div>
              <div style="display: flex; gap: 16px; align-items: center;">
                <div style="width: 88px; height: 110px; border-radius: 8px; background: linear-gradient(135deg, #14223a 0%, #0a1525 100%); border: 1px solid var(--gold-line); display: flex; align-items: center; justify-content: center; color: var(--gold); flex-shrink: 0;">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="22" height="22"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="M21 16 L16 11 L5 21"/></svg>
                </div>
                <div style="flex: 1;">
                  <div style="font-size: 14px; color: var(--ink); margin-bottom: 4px;">portrait-fondatrice.jpg</div>
                  <div style="font-size: 12px; color: var(--ink-4); margin-bottom: 12px;">1200 × 1500 px · 234 Ko</div>
                  <button class="btn-admin btn-admin--ghost" style="padding: 7px 14px; font-size: 12px;">Remplacer</button>
                  <button class="btn-admin btn-admin--danger" style="padding: 7px 14px; font-size: 12px; margin-left: 6px;">Retirer</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Stats band -->
      <div class="editor-section">
        <div class="editor-section__head">
          <div>
            <span class="editor-section__title">Bande de <em>chiffres-clés</em></span>
            <span class="editor-section__hint">4 statistiques affichées en pied de page</span>
          </div>
          <label class="switch"><input type="checkbox" checked><span class="switch__slider"></span></label>
        </div>

        <div class="form-grid">
          <div class="form-row">
            <div><div class="form-label">Chiffre 1</div></div>
            <div><div class="input-group"><input class="input-admin" value="+8" placeholder="Chiffre"><input class="input-admin" value="Années d'expérience" placeholder="Libellé"></div></div>
          </div>
          <div class="form-row">
            <div><div class="form-label">Chiffre 2</div></div>
            <div><div class="input-group"><input class="input-admin" value="+60" placeholder="Chiffre"><input class="input-admin" value="Projets accompagnés" placeholder="Libellé"></div></div>
          </div>
          <div class="form-row">
            <div><div class="form-label">Chiffre 3</div></div>
            <div><div class="input-group"><input class="input-admin" value="5" placeholder="Chiffre"><input class="input-admin" value="Domaines d'expertise" placeholder="Libellé"></div></div>
          </div>
          <div class="form-row">
            <div><div class="form-label">Chiffre 4</div></div>
            <div><div class="input-group"><input class="input-admin" value="24h" placeholder="Chiffre"><input class="input-admin" value="Délai de réponse moyen" placeholder="Libellé"></div></div>
          </div>
        </div>
      </div>

      <!-- Sections visibility -->
      <div class="editor-section">
        <div class="editor-section__head">
          <div>
            <span class="editor-section__title">Sections <em>visibles</em></span>
            <span class="editor-section__hint">Activer ou masquer chaque bloc</span>
          </div>
        </div>
        <div style="display: grid; gap: 2px; background: var(--admin-line); border-radius: 8px; overflow: hidden; border: 1px solid var(--admin-line);">
          <div style="background: var(--admin-surface-2); padding: 14px 18px; display: flex; align-items: center; justify-content: space-between;">
            <div>
              <div style="font-family: var(--font-serif); font-size: 14.5px; color: var(--ink);">Bande logos clients</div>
              <div style="font-size: 11.5px; color: var(--ink-4); margin-top: 2px;">5 références affichées</div>
            </div>
            <label class="switch"><input type="checkbox" checked><span class="switch__slider"></span></label>
          </div>
          <div style="background: var(--admin-surface-2); padding: 14px 18px; display: flex; align-items: center; justify-content: space-between;">
            <div>
              <div style="font-family: var(--font-serif); font-size: 14.5px; color: var(--ink);">Aperçu des services</div>
              <div style="font-size: 11.5px; color: var(--ink-4); margin-top: 2px;">Grille de 6 services</div>
            </div>
            <label class="switch"><input type="checkbox" checked><span class="switch__slider"></span></label>
          </div>
          <div style="background: var(--admin-surface-2); padding: 14px 18px; display: flex; align-items: center; justify-content: space-between;">
            <div>
              <div style="font-family: var(--font-serif); font-size: 14.5px; color: var(--ink);">Bloc « À propos »</div>
              <div style="font-size: 11.5px; color: var(--ink-4); margin-top: 2px;">Présentation + photo atelier</div>
            </div>
            <label class="switch"><input type="checkbox" checked><span class="switch__slider"></span></label>
          </div>
          <div style="background: var(--admin-surface-2); padding: 14px 18px; display: flex; align-items: center; justify-content: space-between;">
            <div>
              <div style="font-family: var(--font-serif); font-size: 14.5px; color: var(--ink);">Témoignages</div>
              <div style="font-size: 11.5px; color: var(--ink-4); margin-top: 2px;">3 cartes avec rating</div>
            </div>
            <label class="switch"><input type="checkbox" checked><span class="switch__slider"></span></label>
          </div>
          <div style="background: var(--admin-surface-2); padding: 14px 18px; display: flex; align-items: center; justify-content: space-between;">
            <div>
              <div style="font-family: var(--font-serif); font-size: 14.5px; color: var(--ink);">Processus en 3 étapes</div>
              <div style="font-size: 11.5px; color: var(--ink-4); margin-top: 2px;">Échange · Mise en place · Accompagnement</div>
            </div>
            <label class="switch"><input type="checkbox" checked><span class="switch__slider"></span></label>
          </div>
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button class="btn-admin btn-admin--ghost">Annuler</button>
        <button class="btn-admin btn-admin--ghost">Brouillon</button>
        <button class="btn-admin btn-admin--primary" data-save>Publier les changements</button>
      </div>

    </div>
  </div>`;
---

<AdminLayout
  title="Pages — Maison Fwurtz Admin" active="contenus"
  breadcrumb="Pages"
  screenLabel="Admin · Pages"
>
  <Fragment set:html={body} />
</AdminLayout>
