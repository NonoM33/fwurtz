---
export const prerender = false;
import AdminLayout from "~/layouts/AdminLayout.astro";

const body = `

  <div class="admin-page-head">
    <div>
      <h1 class="admin-page-head__title">Notifications</h1>
      <p class="admin-page-head__sub">8 nouvelles · 3 messages · 2 alertes · ce qui s'est passé en votre absence.</p>
    </div>
    <div class="admin-page-head__actions">
      <button class="btn-admin btn-admin--ghost">Tout marquer comme lu</button>
      <a class="btn-admin btn-admin--ghost" href="parametres.html#notifications">Préférences</a>
    </div>
  </div>

  <!-- Filter tabs -->
  <div class="crm-toolbar">
    <div class="tabs">
      <button class="tabs__tab is-active">Toutes (16)</button>
      <button class="tabs__tab">Non lues (8)</button>
      <button class="tabs__tab">Messages (3)</button>
      <button class="tabs__tab">Conciergerie (4)</button>
      <button class="tabs__tab">Alertes (2)</button>
    </div>
  </div>

  <!-- Today -->
  <div style="font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold); margin: 0 0 14px;">Aujourd'hui</div>

  <div class="notif-list">

    <a class="notif notif--unread" href="/admin/messages">
      <div class="notif__icon notif__icon--ai"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><polygon points="12 2 15 9 22 12 15 15 12 22 9 15 2 12 9 9"/></svg></div>
      <div>
        <div class="notif__title"><em>Marie</em> · score IA recalculé pour <strong>Camille Larue</strong></div>
        <div class="notif__body">Passé de 82 à <strong style="color: var(--gold);">87/100</strong> après l'échange de 19h12. Décideuse, timing court, budget aligné — prête à signer.</div>
        <div class="notif__actions">
          <button class="btn-admin btn-admin--primary" style="padding: 5px 10px; font-size: 11px; background: #C4B5FD; border-color: #C4B5FD; color: var(--admin-bg);">Voir la fiche</button>
          <button class="btn-admin btn-admin--ghost" style="padding: 5px 10px; font-size: 11px;">Décliner la suggestion</button>
        </div>
      </div>
      <span class="notif__time">12 min</span>
    </a>

    <a class="notif notif--unread" href="/admin/messages">
      <div class="notif__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M8 21 L12 17 L17 17 a4 4 0 004-4 V8 a4 4 0 00-4-4 H7 a4 4 0 00-4 4 v5 a4 4 0 004 4 H8 V21Z"/></svg></div>
      <div>
        <div class="notif__title">Nouveau message de <em>Camille Larue</em></div>
        <div class="notif__body">« Bonjour Marie, je souhaite refondre le site de mon atelier de céramique… » · conciergerie</div>
      </div>
      <span class="notif__time">14 min</span>
    </a>

    <a class="notif notif--unread" href="/admin/rendez-vous">
      <div class="notif__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div>
      <div>
        <div class="notif__title"><strong>RDV à valider</strong> · Camille Larue · Vendredi 17 mai 14h</div>
        <div class="notif__body">Demande envoyée via la conciergerie. Visioconférence de 60 min souhaitée.</div>
        <div class="notif__actions">
          <button class="btn-admin btn-admin--primary" style="padding: 5px 10px; font-size: 11px;">Confirmer</button>
          <button class="btn-admin btn-admin--ghost" style="padding: 5px 10px; font-size: 11px;">Décaler</button>
        </div>
      </div>
      <span class="notif__time">15 min</span>
    </a>

    <a class="notif notif--unread notif--unread" href="/admin/rendez-vous">
      <div class="notif__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div>
      <div>
        <div class="notif__title">RDV confirmé · <em>Julien Hervé</em> · Vendredi 10h</div>
        <div class="notif__body">Galerie Saint-Honoré · invitation Google Cal envoyée automatiquement.</div>
      </div>
      <span class="notif__time">47 min</span>
    </a>

    <a class="notif notif--unread notif--unread" href="/admin/facturation">
      <div class="notif__icon notif__icon--alert"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="13"/><circle cx="12" cy="16.5" r="0.5" fill="currentColor"/></svg></div>
      <div>
        <div class="notif__title"><strong>Facture en retard</strong> · Louis Vermeil · FAC-2026-0011</div>
        <div class="notif__body">3 200 € · échéance dépassée de <strong style="color: #E67878;">12 jours</strong>. Marie suggère une relance comptable.</div>
        <div class="notif__actions">
          <button class="btn-admin btn-admin--danger" style="padding: 5px 10px; font-size: 11px;">Relance comptable</button>
          <button class="btn-admin btn-admin--ghost" style="padding: 5px 10px; font-size: 11px;">Proposer un échelonnement</button>
        </div>
      </div>
      <span class="notif__time">2 h</span>
    </a>

    <a class="notif notif--unread" href="/admin/messages">
      <div class="notif__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></div>
      <div>
        <div class="notif__title">Formulaire de contact · <em>Marc Dubois</em></div>
        <div class="notif__body">Demande pour un mariage à Saint-Cloud en septembre · 120 invités.</div>
      </div>
      <span class="notif__time">2 h</span>
    </a>

    <a class="notif notif--unread" href="/admin/temoignages">
      <div class="notif__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><polygon points="12 3 14.5 9 21 9.5 16 14 17.5 21 12 17.5 6.5 21 8 14 3 9.5 9.5 9"/></svg></div>
      <div>
        <div class="notif__title">Témoignage <em>5 étoiles</em> reçu de Pauline V.</div>
        <div class="notif__body">« Discrétion, élégance, efficacité. » · en attente de publication.</div>
        <div class="notif__actions">
          <button class="btn-admin btn-admin--primary" style="padding: 5px 10px; font-size: 11px;">Publier</button>
          <button class="btn-admin btn-admin--ghost" style="padding: 5px 10px; font-size: 11px;">Modifier</button>
        </div>
      </div>
      <span class="notif__time">4 h</span>
    </a>

    <a class="notif notif--unread" href="/admin/ressources">
      <div class="notif__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 4 V20 L12 18 L20 20 V4 L12 6 Z"/></svg></div>
      <div>
        <div class="notif__title">E-book <em>« Lancer son activité »</em> téléchargé ×3</div>
        <div class="notif__body">Mathilde D., Pierre L., Anne-Sophie B. · Stripe encaissement 147 €.</div>
      </div>
      <span class="notif__time">6 h</span>
    </a>

  </div>

  <!-- Yesterday -->
  <div style="font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-4); margin: 32px 0 14px;">Hier</div>

  <div class="notif-list">

    <a class="notif" href="/admin/contenus">
      <div class="notif__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M11 4 H4 a2 2 0 00-2 2 v14 a2 2 0 002 2 h14 a2 2 0 002-2 v-7"/><path d="M18 2 L22 6 L13 15 L8 16 L9 11 Z"/></svg></div>
      <div>
        <div class="notif__title">Page <strong>Accompagnement juridique</strong> mise à jour</div>
        <div class="notif__body">Section FAQ ajoutée par Sophie F. · 5 questions/réponses.</div>
      </div>
      <span class="notif__time">17h32</span>
    </a>

    <a class="notif" href="/admin/relances">
      <div class="notif__icon notif__icon--ai"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><polygon points="12 2 15 9 22 12 15 15 12 22 9 15 2 12 9 9"/></svg></div>
      <div>
        <div class="notif__title"><em>Marie</em> · 5 relances suggérées détectées</div>
        <div class="notif__body">Devis Marc & Pauline J+4, Mathilde Devos, Raphaël Boyer, Anne-Sophie Bernard, Nadia El-Hassani.</div>
      </div>
      <span class="notif__time">11h08</span>
    </a>

    <a class="notif" href="/admin/equipe">
      <div class="notif__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M4 21 C4 16 8 14 12 14 C16 14 20 16 20 21"/></svg></div>
      <div>
        <div class="notif__title">Léa Marchetti s'est connectée pour la 1<sup>re</sup> fois</div>
        <div class="notif__body">Invitation envoyée le 13 mai, acceptée à 9h41. Rôle « Commerciale » attribué.</div>
      </div>
      <span class="notif__time">09h41</span>
    </a>

    <a class="notif" href="/admin/statistiques">
      <div class="notif__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><line x1="3" y1="20" x2="21" y2="20"/><rect x="5" y="12" width="3" height="8"/><rect x="10" y="7" width="3" height="13"/><rect x="15" y="3" width="3" height="17"/></svg></div>
      <div>
        <div class="notif__title">Rapport hebdomadaire envoyé</div>
        <div class="notif__body">+18,4 % visites · 34 conversations · 12 RDV planifiés. Détails dans votre boîte mail.</div>
      </div>
      <span class="notif__time">09h00</span>
    </a>

  </div>

  <!-- This week -->
  <div style="font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-4); margin: 32px 0 14px;">Cette semaine</div>

  <div class="notif-list">

    <a class="notif" href="/admin/facturation">
      <div class="notif__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M14 2 H6 a2 2 0 00-2 2 v16 a2 2 0 002 2 h12 a2 2 0 002-2 V8 Z"/></svg></div>
      <div>
        <div class="notif__title">Paiement Stripe reçu · <strong>7 100 €</strong></div>
        <div class="notif__body">Galerie Saint-Honoré · acompte 50 % · FAC-2026-0010.</div>
      </div>
      <span class="notif__time">Lun 13/05</span>
    </a>

    <a class="notif" href="/admin/parametres">
      <div class="notif__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 11-14 0 7 7 0 0114 0z"/></svg></div>
      <div>
        <div class="notif__title">Intégration <em>Brevo</em> à configurer</div>
        <div class="notif__body">Marie peut envoyer la newsletter automatiquement dès que Brevo est connecté.</div>
      </div>
      <span class="notif__time">Lun 13/05</span>
    </a>

    <a class="notif" href="/admin/crm">
      <div class="notif__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="5" height="16" rx="1"/><rect x="10" y="4" width="5" height="11" rx="1"/></svg></div>
      <div>
        <div class="notif__title">Domaine Saint-Loup est passé en <em>Client</em></div>
        <div class="notif__body">Denis Rondeau a signé le devis · 8 400 € · implémentation en cours.</div>
      </div>
      <span class="notif__time">Dim 12/05</span>
    </a>

    <a class="notif" href="/admin/messages">
      <div class="notif__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M8 21 L12 17 L17 17 a4 4 0 004-4 V8 a4 4 0 00-4-4 H7 a4 4 0 00-4 4 v5 a4 4 0 004 4 H8 V21Z"/></svg></div>
      <div>
        <div class="notif__title">Nouveau message de <em>Marc & Pauline V.</em></div>
        <div class="notif__body">« Encore mille mercis. Tout était parfait. Nous parlons de vous autour de nous ! »</div>
      </div>
      <span class="notif__time">Dim 12/05</span>
    </a>

  </div>`;
---

<AdminLayout
  title="Notifications — Maison Fwurtz Admin"
  breadcrumb="Notifications"
  screenLabel="Admin · Notifications"
>
  <Fragment set:html={body} />
</AdminLayout>
