---
import { servicesRepo } from "@features/services/infra/repository.ts";

const services = servicesRepo().list({ publishedOnly: true });
---

<section class="section" style="background: var(--navy-900);">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Nos savoir-faire</span>
      <h2 class="serif" style="margin-top: 18px;">
        Un accompagnement complet<br />pour tous vos
        <em class="italic" style="color: var(--gold);">besoins</em>.
      </h2>
      <div class="divider divider--center"></div>
    </div>
    <div class="services-grid reveal reveal-delay-1">
      {services.map((service) => (
        <a class="service-card" href={`/services/${service.slug}`}>
          {service.icon && (
            <svg
              class="service-card__icon"
              viewBox="0 0 48 48"
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={service.icon}
            />
          )}
          <h3>{service.title}</h3>
          <p>{service.summary}</p>
        </a>
      ))}
    </div>
  </div>
</section>
