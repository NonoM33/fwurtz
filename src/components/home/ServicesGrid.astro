---
interface Service {
  href: string;
  title: string;
  description: string;
  icon: string;
}

const services: Service[] = [
  {
    href: "/services/creation-sites-web",
    title: "Création de<br>sites web",
    description: "Des sites modernes, performants et adaptés à votre activité.",
    icon: `<rect x="6" y="9" width="36" height="24" rx="2"/><line x1="6" y1="14" x2="42" y2="14"/><line x1="18" y1="38" x2="30" y2="38"/><line x1="20" y1="33" x2="20" y2="38"/><line x1="28" y1="33" x2="28" y2="38"/>`,
  },
  {
    href: "/services/creation-sites-web",
    title: "Solutions<br>digitales",
    description: "Automatisation, outils et stratégies digitales sur mesure.",
    icon: `<rect x="16" y="6" width="16" height="36" rx="3"/><circle cx="24" cy="37" r="1.2" fill="currentColor"/><line x1="20" y1="10" x2="28" y2="10"/>`,
  },
  {
    href: "/services/gestion-administrative",
    title: "Gestion<br>administrative",
    description: "Organisation, suivi et gestion efficace de vos tâches.",
    icon: `<path d="M6 14 L20 14 L22 17 L42 17 L42 38 L6 38 Z"/><line x1="6" y1="22" x2="42" y2="22"/>`,
  },
  {
    href: "/services/accompagnement-juridique",
    title: "Accompagnement<br>juridique",
    description: "Conseils et soutien juridique pour sécuriser vos projets.",
    icon: `<line x1="24" y1="6" x2="24" y2="42"/><line x1="14" y1="42" x2="34" y2="42"/><path d="M14 12 L8 26 L20 26 Z"/><path d="M34 12 L28 26 L40 26 Z"/><line x1="14" y1="12" x2="34" y2="12"/>`,
  },
  {
    href: "/services/evenementiel",
    title: "Événementiel &<br>coordination",
    description: "Organisation d'événements professionnels et privés clé en main.",
    icon: `<rect x="7" y="10" width="34" height="30" rx="2"/><line x1="7" y1="18" x2="41" y2="18"/><line x1="15" y1="6" x2="15" y2="14"/><line x1="33" y1="6" x2="33" y2="14"/><rect x="14" y="24" width="6" height="5"/><rect x="28" y="24" width="6" height="5"/>`,
  },
  {
    href: "/services",
    title: "Apport<br>d'affaires",
    description: "Mise en relation et développement de votre réseau.",
    icon: `<path d="M6 26 L14 18 L20 22 L26 16 L34 22 L42 14"/><path d="M16 30 L22 26 L28 28 L34 24 L42 28 L42 36 L6 36 L6 30 L10 28 Z"/>`,
  },
];
---

<section class="section" style="background: var(--navy-900);">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Nos savoir-faire</span>
      <h2 class="serif" style="margin-top: 18px;">
        Un accompagnement complet<br />pour tous vos
        <em class="italic" style="color: var(--gold);">besoins</em>.
      </h2>
      <div class="divider divider--center"></div>
    </div>
    <div class="services-grid reveal reveal-delay-1">
      {
        services.map((service) => (
          <a class="service-card" href={service.href}>
            <svg
              class="service-card__icon"
              viewBox="0 0 48 48"
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={service.icon}
            />
            <h3 set:html={service.title} />
            <p>{service.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>
