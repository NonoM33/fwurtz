---

<section
  class="section--tight"
  style="background: var(--navy-950); padding-bottom: var(--section);"
>
  <div class="container">
    <div class="cta-center reveal" style="position: relative; overflow: hidden;">
      <span
        style="position: absolute; right: 4%; top: 50%; transform: translateY(-50%); font-family: var(--font-serif); font-size: 200px; color: rgba(212,175,122,0.05); font-style: italic; pointer-events: none; line-height: 1;"
        >MF.</span
      >
      <span class="eyebrow" style="position: relative; z-index: 2;">Premier échange</span>
      <h2 class="serif" style="margin-top: 18px; position: relative; z-index: 2;">
        Un projet, une question ?<br />
        <em class="italic" style="color: var(--gold);">Parlons-en.</em>
      </h2>
      <p
        style="margin: 20px auto 32px; max-width: 48ch; font-size: 15px; color: var(--ink-3); position: relative; z-index: 2;"
      >
        30 minutes pour comprendre vos besoins. Sans engagement, en toute discrétion.
      </p>
      <a class="btn btn--gold btn--lg" href="#" data-open-rdv style="position: relative; z-index: 2;"
        >Réserver un créneau</a
      >
    </div>
  </div>
</section>
