---
import { testimonialsRepo } from "@features/testimonials/infra/repository.ts";
import { initialsOf } from "@features/testimonials/domain/types.ts";

const testimonials = testimonialsRepo().list({ publishedOnly: true, limit: 6 });

const star = `<svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 14.5 9 22 9 16 14 18 22 12 17 6 22 8 14 2 9 9.5 9"/></svg>`;
function starsFor(rating: number): string {
  return star.repeat(Math.max(1, Math.min(5, rating)));
}
---

{testimonials.length > 0 && (
<section class="testimonials">
  <div class="container">
    <div
      class="section-head reveal"
      style="text-align: left; margin-bottom: 48px; position: relative; z-index: 2;"
    >
      <span class="eyebrow">Témoignages</span>
      <h2 class="serif" style="margin-top: 18px; max-width: 18ch;">
        Ce que disent
        <em class="italic" style="color: var(--gold);">celles et ceux</em>
        qui me font confiance.
      </h2>
      <div class="divider"></div>
    </div>
    <div class="testimonial-grid">
      {testimonials.slice(0, 3).map((t, i) => (
        <div class={`testimonial reveal${i > 0 ? ` reveal-delay-${Math.min(i, 2)}` : ""}`}>
          <div class="testimonial__rating" aria-label={`Note ${t.rating} sur 5`} set:html={starsFor(t.rating)} />
          <p class="testimonial__quote">«&nbsp;{t.quote}&nbsp;»</p>
          <div class="testimonial__author">
            <div class="testimonial__avatar">{initialsOf(t.authorName)}</div>
            <div>
              <p class="testimonial__name">{t.authorName}</p>
              <p class="testimonial__role">
                {[t.authorRole, t.authorOrg].filter(Boolean).join(", ")}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
)}
