---
interface Props {
  class?: string;
  /** Pixel height of the rendered logo. Width auto-scales. */
  height?: number;
}

const { class: className, height = 48 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 1000 200"
  height={height}
  style="overflow: visible; display: block; width: auto;"
  aria-label="Maison Fwurtz"
  class={className}
>
  <line x1="80" y1="50" x2="920" y2="50" stroke="#D4AF7A" stroke-width="1.2"></line>
  <text
    x="500"
    y="125"
    text-anchor="middle"
    font-family="Cormorant Garamond, serif"
    font-size="58"
    font-weight="400"
    letter-spacing="11"
    fill="#FFFFFF">MAISON  FWURTZ</text
  >
  <line x1="80" y1="160" x2="460" y2="160" stroke="#D4AF7A" stroke-width="1.2"></line>
  <line x1="540" y1="160" x2="920" y2="160" stroke="#D4AF7A" stroke-width="1.2"></line>
  <path
    d="M 500 150 L 510 160 L 500 170 L 490 160 Z"
    fill="none"
    stroke="#D4AF7A"
    stroke-width="1.2"></path>
</svg>
