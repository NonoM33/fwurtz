---
import Logo from "./Logo.astro";
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <a class="footer-logo" href="/">
          <Logo />
        </a>
        <p>Votre alliée au quotidien pour simplifier, structurer et développer vos projets.</p>
        <div class="footer-social">
          <a href="#" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M19 3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2zM8 17H5.5v-7H8v7zM6.7 8.7a1.5 1.5 0 110-3 1.5 1.5 0 010 3zM18 17h-2.5v-3.4c0-2-2.4-1.9-2.4 0V17H10.6v-7h2.5v1.2c1.1-2 5-2.2 5 2v3.8z"
              ></path></svg
            >
          </a>
          <a href="#" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="3" width="18" height="18" rx="4"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle>
            </svg>
          </a>
          <a href="#" aria-label="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="M3 7l9 6 9-6"></path>
            </svg>
          </a>
        </div>
      </div>
      <div class="footer-col">
        <h4>Navigation</h4>
        <ul>
          <li><a href="/">Accueil</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/a-propos">À propos</a></li>
          <li><a href="/processus">Processus</a></li>
          <li><a href="/ressources">Ressources</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Services</h4>
        <ul>
          <li><a href="/services/creation-sites-web">Création de sites web</a></li>
          <li><a href="/services/gestion-administrative">Gestion administrative</a></li>
          <li><a href="/services/accompagnement-juridique">Accompagnement juridique</a></li>
          <li><a href="/services/evenementiel">Événementiel &amp; coordination</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Contact</h4>
        <ul class="footer-contact">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <path
                d="M22 16.9v3a2 2 0 01-2.2 2A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.6a2 2 0 01-.5 2.1L8 9.7a16 16 0 006.3 6.3l1.3-1.3a2 2 0 012.1-.5c.8.3 1.7.5 2.6.6a2 2 0 011.7 2z"
              ></path>
            </svg> 06 21 22 23 24
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="M3 7l9 6 9-6"></path>
            </svg> contact@maison-fwurtz.fr
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg> Paris, France
          </li>
        </ul>
        <a class="btn btn--outline" href="#" data-open-rdv style="width:100%;">Réserver un échange</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2024 Maison Fwurtz · Tous droits réservés</span>
      <div class="footer-bottom__links">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/mentions-legales#confidentialite">Confidentialité</a>
      </div>
    </div>
  </div>
</footer>
