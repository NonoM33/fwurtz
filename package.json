{
  "name": "fwurtz",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Maison Fwurtz — site vitrine premium avec conciergerie Marie (Groq)",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro preview --host",
    "start": "HOST=0.0.0.0 PORT=${PORT:-3000} node ./dist/server/entry.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "typecheck": "astro check",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^9.1.3",
    "astro": "^5.1.0",
    "better-sqlite3": "^12.10.0",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "happy-dom": "^16.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "vitest": "^2.1.8"
  }
}
