# Required: API key for the Marie concierge LLM provider.
# Default: Groq (https://console.groq.com/keys)
# Override LLM_BASE_URL below to switch to any OpenAI-compatible provider
# (OpenRouter, Cerebras, vLLM, etc.) — the GROQ_API_KEY var name is kept
# for backward compatibility but holds the chosen provider's key.
GROQ_API_KEY=

# Model used for the concierge. With OpenRouter, use e.g.
# `openai/gpt-oss-120b` or `meta-llama/llama-3.3-70b-instruct`.
GROQ_MODEL=openai/gpt-oss-120b

# Optional: chat-completions endpoint URL. Leave empty to use Groq.
# For OpenRouter: https://openrouter.ai/api/v1/chat/completions
LLM_BASE_URL=

# Optional: title sent to OpenRouter for analytics (X-Title header).
LLM_TITLE=Maison Fwurtz

# Concierge rate limiting (per IP, sliding window)
CONCIERGE_RATE_LIMIT=20
CONCIERGE_RATE_WINDOW_SECONDS=60

# Public site URL (used for OG tags, canonical, etc.)
PUBLIC_SITE_URL=https://maison-fwurtz.fr

# Environment label shown nowhere by default but useful for logs
APP_ENV=development

# ===== Back office =====
# Admin login credentials (single-user). The default values match the design
# mock-up so the app starts working out of the box. CHANGE THEM in production.
ADMIN_EMAIL=sophie@maison-fwurtz.fr
ADMIN_PASSWORD=luxe2024
# 32+ random chars used to sign session cookies. Generate with `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=change-me-to-a-random-secret-in-production-please

# On-disk directory where uploaded medias and the slot manifest live.
# Mount a Coolify volume here in production so uploads survive deploys.
MEDIA_DIR=./data/media

# SQLite database file (back-office data: clients, devis, factures, témoignages, etc.)
# Mount the parent directory as a Coolify volume so the DB survives redeploys.
DB_PATH=./data/db.sqlite

# ===== Split deployment (Coolify) =====
# Selects which subset of routes this container exposes.
#   - site  : public marketing pages + /api/concierge
#   - admin : /admin/* and /api/admin/* (also serves /api/media/* for thumbnails)
#   - api   : /api/image-slots/*, /api/media/*, /api/concierge
#   - all   : no filtering (default for local dev / monolith)
APP_ROLE=all

# Public URL of the backend (api role). When set, the site's image-slot
# placeholders fetch images from this URL instead of same-origin.
# Example: https://api.fwurtz.157.180.43.90.sslip.io
PUBLIC_API_URL=

# Comma-separated list of origins allowed to call the backend cross-origin
# (CORS). Only useful on the api container.
# Example: https://app.fwurtz.157.180.43.90.sslip.io,https://admin.fwurtz.157.180.43.90.sslip.io
CORS_ALLOWED_ORIGINS=
