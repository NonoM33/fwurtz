# Required: Groq API key for the Marie concierge.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Model used for the concierge. Default: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Concierge rate limiting (per IP, sliding window)
CONCIERGE_RATE_LIMIT=20
CONCIERGE_RATE_WINDOW_SECONDS=60

# Public site URL (used for OG tags, canonical, etc.)
PUBLIC_SITE_URL=https://maison-fwurtz.fr

# Environment label shown nowhere by default but useful for logs
APP_ENV=development
